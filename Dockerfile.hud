# fix_aggregate_listing on the coding-template (rubric flavor).
#
# Substrate: effect-dynamodb at the pinned base SHA (history vaulted at task
# setup by coding/repo.py), Node 24 + pnpm 10, DynamoDB Local sidecar, hud
# serve. Everything answer-key-shaped lives under /hud (root, mode 700):
# the vault, the hidden rubric grader, and gold.diff. Agent shells drop to
# uid 1000 (setpriv), so /hud is unreadable from the agent side.

FROM node:24-bookworm

ARG REPO_URL=https://github.com/jmenga/effect-dynamodb
ARG BASE_SHA=ccc3ced19424414f0ca0fc6632e5526889ce7d6a

RUN apt-get update && apt-get install -y --no-install-recommends \
        git curl ca-certificates \
        default-jre-headless \
        util-linux \
        python3 python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g pnpm@10

# DynamoDB Local (started by env.py's initialize hook)
RUN mkdir -p /opt/dynamodb-local \
    && curl -fsSL https://s3.us-west-2.amazonaws.com/dynamodb-local/dynamodb_local_latest.tar.gz \
       | tar -xz -C /opt/dynamodb-local

RUN python3 -m venv /opt/hudvenv \
    && /opt/hudvenv/bin/pip install --no-cache-dir "hud==0.6.13"
ENV PATH="/opt/hudvenv/bin:${PATH}"

# Substrate repo at the pinned base commit. History is truncated here and
# additionally vaulted at task setup (coding/repo.py), so the agent gets a
# fresh single-commit repo with working git and no refs to mine.
RUN mkdir -p /workspace \
    && git init -q /workspace/repo \
    && cd /workspace/repo \
    && git remote add origin ${REPO_URL} \
    && git fetch --depth 1 origin ${BASE_SHA} \
    && git checkout -q FETCH_HEAD \
    && git checkout -q -b main \
    && git config --system user.email "dev@localhost" \
    && git config --system user.name "dev" \
    # the repo gets chowned to the agent uid below; root (build steps and the
    # grading process) must still be allowed to run git in it
    && git config --system --add safe.directory /workspace/repo

# chown in the same RUN as the install ("chown what you stage" — the SDK's
# shell_uid no longer recurses at boot, so baked trees must be agent-owned
# at build time; task setup's chown -R then only touches per-task mutations).
RUN cd /workspace/repo \
    && pnpm install --frozen-lockfile \
    && pnpm --filter @effect-dynamodb/schema build \
    && pnpm --filter effect-dynamodb build \
    && pnpm --filter @effect-dynamodb/geo build \
    && chown -R 1000:1000 /workspace/repo

# ── /hud: everything the agent must never read (mode 700, root) ──────────
# hidden rubric grader + pristine copies + grader-owned runner tree + gold
COPY task/grader/ /hud/grader/
COPY task/gold.diff /hud/gold.diff
RUN mkdir -p /hud/grader/pristine /hud/vault /hud/logs \
    && cp -r /workspace/repo/packages/effect-dynamodb/src /hud/grader/pristine/src \
    && cp -r /workspace/repo/packages/effect-dynamodb/test /hud/grader/pristine/test \
    && cp /workspace/repo/packages/effect-dynamodb/vitest.config.ts \
          /workspace/repo/packages/effect-dynamodb/vitest.connected.ts \
          /hud/grader/pristine/ \
    && git -C /workspace/repo rev-parse HEAD > /hud/grader/base_sha \
    && cp -a /workspace/repo /hud/grader/runner \
    && rm -rf /hud/grader/runner/.git /hud/grader/runner/.hud \
    # cp -a preserved the agent uid from the chowned repo; the runner is
    # grader-owned and must be root's
    && chown -R root:root /hud \
    && chmod -R 700 /hud

# Template runtime layout
ENV REPO_DIR=/workspace/repo \
    VAULT_DIR=/hud/vault \
    GRADING_LOGS_DIR=/hud/logs \
    GOLD_DIFF=/hud/gold.diff \
    GRADER_DIR=/hud/grader

WORKDIR /app
COPY coding/ /app/coding/
COPY env.py tasks.py /app/
COPY task/prompt.md /app/task/prompt.md
RUN chmod 600 /app/tasks.py

# Serve tasks.py: it imports the template's Environment (env.py) untouched and
# registers the rubric-task flavor + this task on top of it.
CMD ["hud", "serve", "tasks.py", "--host", "0.0.0.0"]
