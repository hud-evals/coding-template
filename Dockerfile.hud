# The one swe-task image. Task-agnostic: no repository, no grader, no prompt is
# baked in. Everything task-specific arrives as uploads at task setup, so a new
# task never needs a build or a deploy.
#
# The image is a thin base of *installers*, not of pinned runtimes. Every
# ecosystem's own resolver reads what the uploaded repo declares and fetches
# exactly that at task setup (root, before the agent gets the repo):
#
#   Go      /usr/local/go (1.26.x) with GOTOOLCHAIN=auto: go.mod / go.work
#           asking for a newer Go makes `go` download that toolchain itself.
#   Node    fnm under /opt/fnm, 22 + 24 pre-warmed; `use-node [version]`
#           installs/selects from .nvmrc / .node-version / engines.node and
#           enables corepack, so pnpm/yarn come from package.json's
#           `packageManager` (pnpm 10 / yarn 1 are the fallbacks).
#   Python  uv, CPython 3.11 + 3.12 pre-warmed; uv venv / uv sync pick the
#           interpreter from .python-version / requires-python, downloading it
#           when it is not there yet. System python3 only runs hud.
#   Rust    rustup with no toolchain; rust-toolchain.toml or `rustup default
#           stable` at setup.
#   Also    a JRE + DynamoDB Local, SQLite 3.53.4 (library + CLI, the rqlite
#           graders compare against it), git, ripgrep, util-linux (setpriv),
#           build-essential and the usual -dev libraries.
#
# Every toolchain cache lives under the paths in HUD_TOOLCHAIN_CACHES; setup
# fills them as root and env.py hands them to uid 1000 afterwards, so the
# agent can `go get`, `npm install`, `uv add` too. Everything answer-key-shaped
# lives under /hud (root, mode 700). Agent shells drop to uid 1000.

FROM debian:bookworm-slim

ARG GO=1.26.8
ARG FNM=1.39.0
ARG UV=0.12.1
ARG SQLITE_YEAR=2026
ARG SQLITE_AMALGAMATION=3530400
ARG SQLITE_VERSION=3.53.4

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git xz-utils unzip patch build-essential pkg-config \
        libssl-dev libsqlite3-dev libpq-dev zlib1g-dev libffi-dev \
        util-linux ripgrep default-jre-headless \
        python3 python3-venv python3-pip \
    && rm -rf /var/lib/apt/lists/*

# ── Where every toolchain keeps its state. One place to look, one list for
#    env.py to chown to the agent after setup. PATH is static: the Node entry
#    is fnm's `default` alias, which use-node re-points (one task per container).
ENV GOPATH=/go GOMODCACHE=/go/pkg/mod GOCACHE=/gocache GOTOOLCHAIN=auto CGO_ENABLED=1 \
    FNM_DIR=/opt/fnm COREPACK_HOME=/opt/corepack COREPACK_ENABLE_DOWNLOAD_PROMPT=0 COREPACK_DEFAULT_TO_LATEST=0 \
    npm_config_store_dir=/opt/pnpm-store \
    UV_PYTHON_INSTALL_DIR=/opt/uv/python UV_CACHE_DIR=/opt/uv/cache UV_PYTHON_BIN_DIR=/opt/uv/bin \
    RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo \
    HUD_TOOLCHAIN_CACHES=/go:/gocache:/opt/fnm:/opt/corepack:/opt/pnpm-store:/opt/uv:/opt/rustup:/opt/cargo \
    PATH=/opt/hudvenv/bin:/usr/local/node/bin:/usr/local/go/bin:/opt/uv/bin:/opt/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# ── Go: one release under /usr/local/go. GOTOOLCHAIN=auto (the Go default)
#    means a module that requires a newer Go gets it downloaded into
#    GOMODCACHE on first use, by the module's own go.mod / go.work line.
#    No GOFLAGS=-mod=mod any more: Go refuses it in go.work (workspace) mode.
RUN curl -fsSL "https://go.dev/dl/go${GO}.linux-$(dpkg --print-architecture).tar.gz" | tar -xz -C /usr/local \
    && mkdir -p /go /gocache

# ── Node: fnm owns the versions (/opt/fnm/node-versions/<v>), the `default`
#    alias is the one on PATH. use-node resolves a version (argument, else
#    .nvmrc / .node-version / engines.node in $PWD), installs it if needed,
#    makes it the default and enables corepack for it (Node >= 25 no longer
#    bundles corepack, hence the npm fallback). fnm alone needs `eval
#    "$(fnm env)"` per shell; graders and the agent workspace get a fixed
#    env, so the image needs this one command and one stable path. pnpm 10 and
#    yarn 1 are corepack's fallbacks for repos without a `packageManager`.
RUN set -eux; case "$(dpkg --print-architecture)" in amd64) f=fnm-linux ;; arm64) f=fnm-arm64 ;; esac; \
    curl -fsSL "https://github.com/Schniz/fnm/releases/download/v${FNM}/${f}.zip" -o /tmp/fnm.zip \
    && unzip -q /tmp/fnm.zip -d /usr/local/bin && chmod 755 /usr/local/bin/fnm && rm /tmp/fnm.zip; \
    printf '%s\n' \
      '#!/bin/bash' \
      '# use-node [version]: make one Node the default on PATH (/usr/local/node -> fnm default alias).' \
      '# No argument: the version the repo in $PWD declares (.nvmrc, .node-version, engines.node).' \
      'set -euo pipefail' \
      'eval "$(fnm env --shell bash)"' \
      'fnm use --install-if-missing ${1:+"$1"}' \
      'fnm default "$(fnm current)"' \
      'command -v corepack >/dev/null || npm install -g corepack >/dev/null' \
      'corepack enable' \
      'echo "node $(node --version) ($(readlink $FNM_DIR/aliases/default))"' > /usr/local/bin/use-node; \
    chmod 755 /usr/local/bin/use-node; \
    use-node 22 && use-node 24 && ln -s /opt/fnm/aliases/default /usr/local/node; \
    corepack install -g pnpm@10 yarn@1

# ── Python: uv. `uv venv` / `uv sync` honour .python-version and
#    requires-python and download a missing CPython on their own; 3.11 and
#    3.12 are pre-warmed so the common case is offline. python3.X launchers
#    land in /opt/uv/bin (on PATH); `python3` stays Debian's, for hud.
RUN curl -fsSL "https://astral.sh/uv/${UV}/install.sh" | env UV_INSTALL_DIR=/usr/local/bin UV_NO_MODIFY_PATH=1 sh \
    && uv python install 3.11 3.12

# ── Rust: rustup only (~15 MB); the toolchain is the repo's business
#    (rust-toolchain.toml, else `rustup default stable` at setup).
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --no-modify-path --default-toolchain none --profile minimal

# ── Login shells (the agent's ssh) do not inherit the image ENV, and the
#    graders' non-interactive bash gets it from env.py; profile.d + bashrc
#    give every interactive shell the same view.
RUN for v in PATH GOPATH GOMODCACHE GOCACHE GOTOOLCHAIN CGO_ENABLED FNM_DIR COREPACK_HOME \
             COREPACK_ENABLE_DOWNLOAD_PROMPT COREPACK_DEFAULT_TO_LATEST npm_config_store_dir \
             UV_PYTHON_INSTALL_DIR UV_CACHE_DIR UV_PYTHON_BIN_DIR RUSTUP_HOME CARGO_HOME; do \
      printf 'export %s="%s"\n' "$v" "$(printenv "$v")"; \
    done > /etc/profile.d/10-hud-toolchains.sh \
    && chmod 0644 /etc/profile.d/10-hud-toolchains.sh \
    && cat /etc/profile.d/10-hud-toolchains.sh >> /etc/bash.bashrc

# ── DynamoDB Local (a task's services.sh starts it when it needs it).
RUN mkdir -p /opt/dynamodb-local \
    && curl -fsSL https://s3.us-west-2.amazonaws.com/dynamodb-local/dynamodb_local_latest.tar.gz \
       | tar -xz -C /opt/dynamodb-local

# ── SQLite ${SQLITE_VERSION}: the exact library and CLI the rqlite graders
#    compare against (Debian's is older). Python's sqlite3 module picks up the
#    shared library through LD_LIBRARY_PATH; /usr/local/include shadows the
#    libsqlite3-dev headers for cgo builds.
RUN set -eux; cd /tmp; \
    curl -fsSL "https://sqlite.org/${SQLITE_YEAR}/sqlite-autoconf-${SQLITE_AMALGAMATION}.tar.gz" -o sqlite.tar.gz; \
    tar -xzf sqlite.tar.gz; cd "sqlite-autoconf-${SQLITE_AMALGAMATION}"; \
    FLAGS="-O2 -DSQLITE_ENABLE_COLUMN_METADATA -DSQLITE_ENABLE_FTS3 -DSQLITE_ENABLE_FTS3_PARENTHESIS \
           -DSQLITE_ENABLE_FTS4 -DSQLITE_ENABLE_FTS5 -DSQLITE_ENABLE_RTREE -DSQLITE_ENABLE_GEOPOLY \
           -DSQLITE_ENABLE_JSON1 -DSQLITE_ENABLE_MATH_FUNCTIONS -DSQLITE_ENABLE_DBSTAT_VTAB \
           -DSQLITE_ENABLE_UPDATE_DELETE_LIMIT -DSQLITE_ENABLE_PREUPDATE_HOOK -DSQLITE_ENABLE_SESSION \
           -DSQLITE_THREADSAFE=1 -DHAVE_USLEEP=1"; \
    gcc $FLAGS -fPIC -shared -Wl,-soname,libsqlite3.so.0 -o /usr/local/lib/libsqlite3.so.0.8.6 sqlite3.c -lm -lpthread -ldl; \
    ln -sf libsqlite3.so.0.8.6 /usr/local/lib/libsqlite3.so.0; ln -sf libsqlite3.so.0.8.6 /usr/local/lib/libsqlite3.so; \
    cp -f sqlite3.h sqlite3ext.h /usr/local/include/; \
    cp -f /usr/local/lib/libsqlite3.so.0.8.6 "/usr/lib/$(gcc -print-multiarch)/libsqlite3.so.0.8.6"; \
    gcc $FLAGS -o /usr/local/bin/sqlite3 shell.c sqlite3.c -lm -lpthread -ldl; \
    ldconfig; cd /tmp && rm -rf "sqlite-autoconf-${SQLITE_AMALGAMATION}" sqlite.tar.gz
ENV LD_LIBRARY_PATH=/usr/local/lib GRADER_SQLITE3=/usr/local/bin/sqlite3

# ── hud, in its own venv (never the agent's), and this environment.
RUN python3 -m venv /opt/hudvenv \
    && /opt/hudvenv/bin/pip install --no-cache-dir "hud==0.6.18" "httpx>=0.27" \
    && /opt/hudvenv/bin/python -c "import sqlite3; assert sqlite3.sqlite_version == '${SQLITE_VERSION}', sqlite3.sqlite_version"

RUN git config --system user.email "dev@localhost" && git config --system user.name "dev" \
    && mkdir -p /workspace/repo /hud/vault /hud/logs /hud/grader \
    && chown -R root:root /hud && chmod -R 700 /hud

# Template runtime layout: an empty workspace the task fills.
ENV REPO_DIR=/workspace/repo \
    VAULT_DIR=/hud/vault \
    GRADING_LOGS_DIR=/hud/logs \
    GRADER_DIR=/hud/grader

WORKDIR /app
COPY coding/ /app/coding/
COPY env.py /app/

CMD ["hud", "serve", "env.py", "--host", "0.0.0.0"]
