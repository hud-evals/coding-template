# The one swe-task image. Task-agnostic: no repository, no grader, no prompt is
# baked in. Everything task-specific arrives as uploads at task setup, so a new
# task never needs a build or a deploy. What the image does carry is every
# toolchain the tasks so far needed, side by side:
#
#   Node 22 + Node 24 (+ pnpm 10)      use-node <22|24>   (default 24)
#   Go 1.25 + Go 1.26                  use-go <1.25|1.26> (default 1.26)
#   Python 3.12, a JRE + DynamoDB Local, SQLite 3.53.4 (library + CLI),
#   git, ripgrep, util-linux (setpriv), build-essential.
#
# A task's grading/setup.sh picks its toolchain (`use-node 22`) and installs the
# repo's dependencies; without one the env auto-detects from lockfiles.
# Everything answer-key-shaped lives under /hud (root, mode 700): the vault,
# the grading pack, gold.diff, llm_rubric.json. Agent shells drop to uid 1000.

FROM debian:bookworm-slim

ARG NODE22=22.19.0
ARG NODE24=24.8.0
ARG GO125=1.25.1
ARG GO126=1.26.2
ARG SQLITE_YEAR=2026
ARG SQLITE_AMALGAMATION=3530400
ARG SQLITE_VERSION=3.53.4

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git xz-utils patch build-essential \
        util-linux ripgrep default-jre-headless \
        python3 python3-venv python3-pip \
    && rm -rf /var/lib/apt/lists/*

# ── Node 22 and 24 under /opt/node/<major>; /usr/local/node points at the
#    active one and is on PATH. use-node re-points it (one task per container).
RUN set -eux; arch="$(dpkg --print-architecture)"; case "$arch" in amd64) n=x64 ;; arm64) n=arm64 ;; esac; \
    for v in ${NODE22} ${NODE24}; do \
      major="${v%%.*}"; mkdir -p "/opt/node/${major}"; \
      curl -fsSL "https://nodejs.org/dist/v${v}/node-v${v}-linux-${n}.tar.xz" \
        | tar -xJ -C "/opt/node/${major}" --strip-components=1; \
    done; \
    ln -s /opt/node/24 /usr/local/node; \
    printf '#!/bin/sh\nset -e\n[ -d "/opt/node/$1" ] || { echo "no Node $1 (have: $(ls /opt/node))" >&2; exit 1; }\nln -sfn "/opt/node/$1" /usr/local/node\n' > /usr/local/bin/use-node; \
    chmod 755 /usr/local/bin/use-node; \
    for major in 22 24; do use-node "$major" && /usr/local/node/bin/npm install -g pnpm@10 >/dev/null; done; \
    use-node 24
ENV PATH="/usr/local/node/bin:${PATH}"

# ── Go 1.25 and 1.26 under /opt/go/<minor>; /usr/local/go is the active one.
RUN set -eux; arch="$(dpkg --print-architecture)"; \
    for v in ${GO125} ${GO126}; do \
      minor="${v%.*}"; mkdir -p "/opt/go/${minor}"; \
      curl -fsSL "https://go.dev/dl/go${v}.linux-${arch}.tar.gz" | tar -xz -C "/opt/go/${minor}" --strip-components=1; \
    done; \
    ln -s /opt/go/1.26 /usr/local/go; \
    printf '#!/bin/sh\nset -e\n[ -d "/opt/go/$1" ] || { echo "no Go $1 (have: $(ls /opt/go))" >&2; exit 1; }\nln -sfn "/opt/go/$1" /usr/local/go\n' > /usr/local/bin/use-go; \
    chmod 755 /usr/local/bin/use-go
# Shared module cache (read-only for the agent after setup) and a build cache
# the env copies into the agent's home warm. GOTOOLCHAIN=local: never download
# another Go at run time.
ENV PATH="/usr/local/go/bin:${PATH}" \
    GOPATH=/go GOMODCACHE=/go/pkg/mod GOCACHE=/gocache GOTOOLCHAIN=local GOFLAGS=-mod=mod CGO_ENABLED=1
RUN mkdir -p /go /gocache && chmod -R 0777 /go /gocache \
    && printf '%s\n' \
      'case ":$PATH:" in *:/usr/local/go/bin:*) ;; *) PATH="/usr/local/go/bin:$PATH" ;; esac' \
      'case ":$PATH:" in *:/usr/local/node/bin:*) ;; *) PATH="/usr/local/node/bin:$PATH" ;; esac' \
      'export PATH' \
      'if [ "$(id -u)" != "0" ]; then' \
      '    : "${GOPATH:=/go}"; : "${GOMODCACHE:=/go/pkg/mod}"; : "${GOCACHE:=$HOME/.cache/go-build}"' \
      '    : "${GOFLAGS:=-mod=mod}"; : "${GOTOOLCHAIN:=local}"; : "${CGO_ENABLED:=1}"' \
      '    export GOPATH GOMODCACHE GOCACHE GOFLAGS GOTOOLCHAIN CGO_ENABLED' \
      'fi' > /etc/profile.d/10-hud-toolchains.sh \
    && chmod 0644 /etc/profile.d/10-hud-toolchains.sh \
    && cat /etc/profile.d/10-hud-toolchains.sh >> /etc/bash.bashrc

# ── DynamoDB Local (a task's services.sh starts it when it needs it).
RUN mkdir -p /opt/dynamodb-local \
    && curl -fsSL https://s3.us-west-2.amazonaws.com/dynamodb-local/dynamodb_local_latest.tar.gz \
       | tar -xz -C /opt/dynamodb-local

# ── SQLite ${SQLITE_VERSION}: the exact library and CLI the rqlite graders
#    compare against (Debian's is older). Python's sqlite3 module picks up the
#    shared library through LD_LIBRARY_PATH.
RUN set -eux; cd /tmp; \
    curl -fsSL "https://sqlite.org/${SQLITE_YEAR}/sqlite-autoconf-${SQLITE_AMALGAMATION}.tar.gz" -o sqlite.tar.gz; \
    tar -xzf sqlite.tar.gz; cd "sqlite-autoconf-${SQLITE_AMALGAMATION}"; \
    FLAGS="-O2 -DSQLITE_ENABLE_COLUMN_METADATA -DSQLITE_ENABLE_FTS3 -DSQLITE_ENABLE_FTS3_PARENTHESIS \
           -DSQLITE_ENABLE_FTS4 -DSQLITE_ENABLE_FTS5 -DSQLITE_ENABLE_RTREE -DSQLITE_ENABLE_GEOPOLY \
           -DSQLITE_ENABLE_JSON1 -DSQLITE_ENABLE_MATH_FUNCTIONS -DSQLITE_ENABLE_DBSTAT_VTAB \
           -DSQLITE_ENABLE_UPDATE_DELETE_LIMIT -DSQLITE_ENABLE_PREUPDATE_HOOK -DSQLITE_ENABLE_SESSION \
           -DSQLITE_THREADSAFE=1 -DHAVE_USLEEP=1"; \
    gcc $FLAGS -fPIC -shared -Wl,-soname,libsqlite3.so.0 -o /usr/local/lib/libsqlite3.so.0.8.6 sqlite3.c -lm -lpthread -ldl; \
    ln -sf libsqlite3.so.0.8.6 /usr/local/lib/libsqlite3.so.0; ln -sf libsqlite3.so.0.8.6 /usr/local/lib/libsqlite3.so; \
    cp -f sqlite3.h sqlite3ext.h /usr/local/include/; \
    cp -f /usr/local/lib/libsqlite3.so.0.8.6 "/usr/lib/$(gcc -print-multiarch)/libsqlite3.so.0.8.6"; \
    gcc $FLAGS -o /usr/local/bin/sqlite3 shell.c sqlite3.c -lm -lpthread -ldl; \
    ldconfig; cd /tmp && rm -rf "sqlite-autoconf-${SQLITE_AMALGAMATION}" sqlite.tar.gz
ENV LD_LIBRARY_PATH=/usr/local/lib GRADER_SQLITE3=/usr/local/bin/sqlite3

# ── hud, in its own venv (never the agent's), and this environment.
RUN python3 -m venv /opt/hudvenv \
    && /opt/hudvenv/bin/pip install --no-cache-dir "hud==0.6.13" "httpx>=0.27" \
    && /opt/hudvenv/bin/python -c "import sqlite3; assert sqlite3.sqlite_version == '${SQLITE_VERSION}', sqlite3.sqlite_version"
ENV PATH="/opt/hudvenv/bin:${PATH}"

RUN git config --system user.email "dev@localhost" && git config --system user.name "dev" \
    && mkdir -p /workspace/repo /hud/vault /hud/logs /hud/grader \
    && chown -R root:root /hud && chmod -R 700 /hud

# Template runtime layout: an empty workspace the task fills.
ENV REPO_DIR=/workspace/repo \
    VAULT_DIR=/hud/vault \
    GRADING_LOGS_DIR=/hud/logs \
    GRADER_DIR=/hud/grader

WORKDIR /app
COPY coding/ /app/coding/
COPY env.py /app/

CMD ["hud", "serve", "env.py", "--host", "0.0.0.0"]
