+                toAttributeMap({
+                  user: "u2",
+                  text: `${postId} c2`,
+                  pk,
+                  lsi1sk: "$myapp#v1#postcomment#2",
+                  __edd_e__: "PostComment",
+                }),
+              ],
+            })
+          })
+
+          const results = yield* PostAggregate.list()
+
+          expect(results.data).toHaveLength(2)
+          for (const post of results.data) {
+            expect(post.author.name).toBe(`Author of ${post.postId}`)
+            expect(post.comments.map((c) => c.text)).toEqual([
+              `${post.postId} c1`,
+              `${post.postId} c2`,
+            ])
+          }
+        }).pipe(Effect.provide(ListLayer)),
+    )
+
+    it.effect(
+      "assembly: a failing partition query fails the whole list with the tagged error",
+      () =>
+        Effect.gen(function* () {
+          mockListQuery.mockImplementation((input: Record<string, unknown>) => {
+            if (input.IndexName === "gsi1") {
+              return Promise.resolve({
+                Items: ["a-1", "a-2"].map((articleId) =>
+                  toAttributeMap({
+                    pk: `$myapp#v1#article#${articleId}`,
+                    sk: "$myapp#v1#articleitem",
+                    gsi1pk: "$myapp#v1#articlelist",
+                    gsi1sk: `$myapp#v1#articlelist#alice#${articleId}`,
+                    __edd_e__: "ArticleItem",
+                    articleId,
+                    title: articleId,
+                    author: "alice",
+                    tags: [],
+                  }),
+                ),
+              })
+            }
+            const pk = (input.ExpressionAttributeValues as Record<string, { S: string }>)[":pk"]!.S
+            if (pk === "$myapp#v1#article#a-2") {
+              return Promise.reject(new Error("provisioned throughput exceeded"))
+            }
+            return Promise.resolve({
+              Items: [
+                toAttributeMap({
+                  pk,
+                  sk: "$myapp#v1#articleitem",
+                  __edd_e__: "ArticleItem",
+                  articleId: "a-1",
+                  title: "a-1",
+                  author: "alice",
+                  tags: [],
+                }),
+              ],
+            })
+          })
+
+          const error = yield* Effect.flip(ListAggregate.list())
+
+          expect(error._tag).toBe("DynamoError")
+        }).pipe(Effect.provide(ListLayer)),
+    )
   })
 })
diff --git a/packages/effect-dynamodb/test/connected.test.ts b/packages/effect-dynamodb/test/connected.test.ts
index 86c6e21..b934092 100644
--- a/packages/effect-dynamodb/test/connected.test.ts
+++ b/packages/effect-dynamodb/test/connected.test.ts
@@ -5130,3 +5130,237 @@ describeConnected("#71/#72 — pure aggregate edges + Pattern B date fields", ()
       }).pipe(provideEdd),
   )
 })
+
+// ===========================================================================
+// Aggregate.list — cursor pagination, sharded lists, edge assembly
+// ===========================================================================
+//
+// list() assembles each page's aggregates concurrently (bounded) and, for
+// sharded list collections (`cardinality`), fans out to every shard and merges
+// the shard streams in ascending list-SK order behind an opaque per-shard
+// cursor. These tests exercise what mocks can't prove: real GSI key order,
+// real LastEvaluatedKey behavior, and full pagination walks with a limit that
+// truncates mid-shard — no aggregate skipped or duplicated, stable order.
+
+class GadgetNote extends Schema.Class<GadgetNote>("GadgetNote")({
+  id: Schema.String,
+  text: Schema.String,
+}) {}
+
+class Gadget extends Schema.Class<Gadget>("Gadget")({
+  id: Schema.String,
+  name: Schema.String,
+  notes: Schema.Array(GadgetNote),
+}) {}
+
+// Minimal registered entity — the table derives its primary index from it
+class GadgetOwner extends Schema.Class<GadgetOwner>("GadgetOwner")({
+  id: Schema.String,
+  name: Schema.String,
+}) {}
+
+const GadgetOwners = Entity.make({
+  model: GadgetOwner,
+  entityType: "GadgetOwner",
+  primaryKey: {
+    pk: { field: "pk", composite: ["id"] },
+    sk: { field: "sk", composite: [] },
+  },
+})
+
+const ListSchema = DynamoSchema.make({ name: "list-test", version: 1 })
+const listTableName = `agg-list-test-${Date.now()}`
+const ListTable = Table.make({ schema: ListSchema, entities: { GadgetOwners } })
+
+// Unsharded list collection
+const GadgetAggregate = Aggregate.make(Gadget, {
+  table: ListTable,
+  schema: ListSchema,
+  pk: { field: "pk", composite: ["id"] },
+  collection: { index: "lsiG", name: "gadget", sk: { field: "lsiGsk", composite: [] } },
+  list: {
+    index: "gsiList",
+    name: "gadgetlist",
+    pk: { field: "gsiListPk", composite: [] },
+    sk: { field: "gsiListSk", composite: ["name"] },
+  },
+  root: { entityType: "GadgetRoot" },
+  edges: {
+    notes: Aggregate.many("notes", { entityType: "GadgetNote" }),
+  },
+})
+
+// Sharded list collection — same domain model, write load spread over 3 shards
+const HotGadgetAggregate = Aggregate.make(Gadget, {
+  table: ListTable,
+  schema: ListSchema,
+  pk: { field: "pk", composite: ["id"] },
+  collection: { index: "lsiH", name: "hotgadget", sk: { field: "lsiHsk", composite: [] } },
+  list: {
+    index: "gsiHot",
+    name: "hotlist",
+    pk: { field: "gsiHotPk", composite: [] },
+    sk: { field: "gsiHotSk", composite: ["name"] },
+    cardinality: 3,
+  },
+  root: { entityType: "HotGadgetRoot" },
+  edges: {
+    notes: Aggregate.many("notes", { entityType: "HotGadgetNote" }),
+  },
+})
+
+const ListTestLayer = Layer.mergeAll(ClientLayer, ListTable.layer({ name: listTableName }))
+const provideList = Effect.provide(ListTestLayer)
+
+const gadgetIds = Array.from({ length: 12 }, (_, i) => `g-${String(i + 1).padStart(2, "0")}`)
+const gadgetNames = gadgetIds.map((id) => `name-${id}`)
+
+describeConnected("Aggregate.list integration tests", () => {
+  beforeAll(async () => {
+    await Effect.runPromise(
+      Effect.gen(function* () {
+        // The aggregate→table auto-merge wires both aggregates' collection
+        // (LSI) and list (GSI) indexes into the CreateTable call.
+        const db = yield* DynamoClient.make({
+          entities: { GadgetOwners },
+          aggregates: { GadgetAggregate, HotGadgetAggregate },
+          tables: { ListTable },
+        })
+        yield* db.tables.ListTable.create()
+      }).pipe(provideList, Effect.scoped),
+    )
+  }, 15000)
+
+  afterAll(async () => {
+    await Effect.runPromise(
+      Effect.gen(function* () {
+        const client = yield* DynamoClient
+        yield* client.deleteTable({ TableName: listTableName })
+      }).pipe(
+        provideList,
+        Effect.scoped,
+        Effect.catchTag("ResourceNotFoundError", () => Effect.void),
+      ),
+    )
+  }, 15000)
+
+  it.effect("seed 12 aggregates (with edges) into both list collections", () =>
+    Effect.gen(function* () {
+      for (const id of gadgetIds) {
+        const input = {
+          id,
+          name: `name-${id}`,
+          notes: [
+            { id: `${id}-n1`, text: `${id} first note` },
+            { id: `${id}-n2`, text: `${id} second note` },
+          ],
+        }
+        yield* GadgetAggregate.create(input)
+        yield* HotGadgetAggregate.create(input)
+      }
+
+      const one = yield* GadgetAggregate.get({ id: "g-01" })
+      expect(one.notes).toHaveLength(2)
+    }).pipe(provideList),
+  )
+
+  describe("unsharded list", () => {
+    it.effect("returns every aggregate fully assembled (edges included), cursor null", () =>
+      Effect.gen(function* () {
+        const result = yield* GadgetAggregate.list()
+
+        expect(result.cursor).toBeNull()
+        expect(result.data.map((g) => g.name)).toEqual(gadgetNames) // ascending list-SK order
+        for (const gadget of result.data) {
+          expect(gadget.notes.map((n) => n.text).sort()).toEqual([
+            `${gadget.id} first note`,
+            `${gadget.id} second note`,
+          ])
+        }
+      }).pipe(provideList),
+    )
+
+    it.effect("paginates to exhaustion: page size honored, no skips, no duplicates", () =>
+      Effect.gen(function* () {
+        const pages: Array<Array<string>> = []
+        let cursor: string | undefined
+        do {
+          const page = yield* GadgetAggregate.list(undefined, { limit: 5, cursor })
+          pages.push(page.data.map((g) => g.name))
+          cursor = page.cursor ?? undefined
+        } while (cursor !== undefined)
+
+        expect(pages.map((p) => p.length)).toEqual([5, 5, 2])
+        expect(pages.flat()).toEqual(gadgetNames)
+      }).pipe(provideList),
+    )
+  })
+
+  describe("sharded list (cardinality 3)", () => {
+    it.effect("returns every aggregate fully assembled (edges included), cursor null", () =>
+      Effect.gen(function* () {
+        const result = yield* HotGadgetAggregate.list()
+
+        expect(result.cursor).toBeNull()
+        // Deterministic merge order: ascending list-SK across all shards
+        expect(result.data.map((g) => g.name)).toEqual(gadgetNames)
+        for (const gadget of result.data) {
+          expect(gadget.notes.map((n) => n.text).sort()).toEqual([
+            `${gadget.id} first note`,
+            `${gadget.id} second note`,
+          ])
+        }
+      }).pipe(provideList),
+    )
+
+    it.effect("paginates to exhaustion with a limit that truncates mid-shard", () =>
+      Effect.gen(function* () {
+        // limit 5 over 3 hash-distributed shards: every page boundary cuts
+        // through at least one shard's fetched-but-not-emitted items, so this
+        // walk fails if per-shard resume keys are taken from the raw
+        // LastEvaluatedKey instead of the last emitted item.
+        const walk = Effect.gen(function* () {
+          const pages: Array<Array<string>> = []
+          let cursor: string | undefined
+          do {
+            const page = yield* HotGadgetAggregate.list(undefined, { limit: 5, cursor })
+            expect(page.data.length).toBeLessThanOrEqual(5)
+            pages.push(page.data.map((g) => g.id))
+            cursor = page.cursor ?? undefined
+          } while (cursor !== undefined)
+          return pages
+        })
+
+        const pages = yield* walk
+        const ids = pages.flat()
+
+        // Exact coverage: nothing skipped, nothing duplicated
+        expect(ids).toHaveLength(12)
+        expect(new Set(ids).size).toBe(12)
+        // Page size honored until exhaustion
+        expect(pages.map((p) => p.length)).toEqual([5, 5, 2])
+        // Deterministic order: globally ascending list-SK across the walk
+        expect(ids).toEqual(gadgetIds)
+        // Stable: a second walk returns the identical page sequence
+        const again = yield* walk
+        expect(again).toEqual(pages)
+      }).pipe(provideList),
+    )
+
+    it.effect("edges stay assembled on every page of a paginated walk", () =>
+      Effect.gen(function* () {
+        let cursor: string | undefined
+        do {
+          const page = yield* HotGadgetAggregate.list(undefined, { limit: 5, cursor })
+          for (const gadget of page.data) {
+            expect(gadget.notes.map((n) => n.text).sort()).toEqual([
+              `${gadget.id} first note`,
+              `${gadget.id} second note`,
+            ])
+          }
+          cursor = page.cursor ?? undefined
+        } while (cursor !== undefined)
+      }).pipe(provideList),
+    )
+  })
+})
