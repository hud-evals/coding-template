+// ---------------------------------------------------------------------------
+// Internal: List concurrency + sharded list pagination
+// ---------------------------------------------------------------------------
+
+/**
+ * Maximum concurrent DynamoDB queries issued by `list()` — bounds both the
+ * sharded fan-out and the per-root partition assembly. Deliberately a bounded
+ * number (mirroring the cascade update bound in Entity.ts), never unlimited:
+ * each root assembly is a full-partition query, so a page of N aggregates
+ * fanned out without a bound would issue N simultaneous queries and can
+ * exhaust modest provisioned throughput.
+ */
+const LIST_CONCURRENCY = 10
+
+/**
+ * Opaque cursor envelope for sharded lists: per-shard resume keys, keyed by
+ * shard index. `null` resumes a shard from its beginning; a missing entry
+ * means the shard is exhausted. Resume keys are synthesized from the last item
+ * a shard contributed to the returned page — never the shard query's raw
+ * `LastEvaluatedKey`, which would skip items fetched but cut by the page-level
+ * truncation. Unsharded lists keep the original raw-LastEvaluatedKey cursor
+ * format (deployed clients hold those cursors).
+ *
+ * The envelope assumes `cardinality` is fixed for the duration of a pagination
+ * walk: a shard absent from an incoming envelope is treated as exhausted, so
+ * raising `cardinality` mid-walk leaves the new shards unread until a fresh
+ * (cursor-less) walk starts.
+ */
+interface ShardedListCursor {
+  readonly _tag: "ShardedListCursor"
+  readonly shards: Record<string, Record<string, AttributeValue> | null>
+}
+
+/**
+ * Decode and validate a sharded-list cursor. Returns `undefined` for anything
+ * that is not a well-formed {@link ShardedListCursor} — corrupted input, or a
+ * cursor minted by a different list format (e.g. an unsharded
+ * raw-LastEvaluatedKey cursor presented after `cardinality` was added to the
+ * config) — so the caller can fail with a typed `ValidationError` instead of
+ * a raw parse defect.
+ */
+const decodeShardedListCursor = (cursor: string): ShardedListCursor | undefined => {
+  try {
+    const parsed = JSON.parse(atob(cursor)) as Partial<ShardedListCursor> | null
+    return typeof parsed === "object" &&
+      parsed !== null &&
+      parsed._tag === "ShardedListCursor" &&
+      typeof parsed.shards === "object" &&
+      parsed.shards !== null
+      ? (parsed as ShardedListCursor)
+      : undefined
+  } catch {
+    return undefined
+  }
+}
+
+/**
+ * Build a GSI `ExclusiveStartKey` from an emitted root item. A GSI start key
+ * must carry BOTH the index keys and the table primary keys.
+ */
+const shardResumeKey = (
+  item: Record<string, unknown>,
+  listConfig: ListCollectionConfig,
+  tablePkField: string,
+): Record<string, AttributeValue> =>
+  toAttributeMap({
+    [listConfig.pk.field]: item[listConfig.pk.field],
+    [listConfig.sk.field]: item[listConfig.sk.field],
+    [tablePkField]: item[tablePkField],
+    sk: item.sk,
+  })
+
+/**
+ * True when `a` sorts strictly before `b` in Unicode code-point order — which,
+ * for well-formed strings, is exactly DynamoDB's UTF-8-byte ordering of string
+ * keys. JS `<` compares UTF-16 code units instead, which misorders
+ * astral-plane characters (surrogate pairs, e.g. emoji) against BMP characters
+ * in U+E000–U+FFFF.
+ */
+const utf8Before = (a: string, b: string): boolean => {
+  const length = Math.min(a.length, b.length)
+  let index = 0
+  while (index < length) {
+    const codePointA = a.codePointAt(index) ?? 0
+    const codePointB = b.codePointAt(index) ?? 0
+    if (codePointA !== codePointB) return codePointA < codePointB
+    // Equal code points have equal width, so both strings advance in lockstep.
+    index += codePointA > 0xffff ? 2 : 1
+  }
+  // One string is a prefix of the other — the shorter sorts first.
+  return a.length < b.length
+}
+
+/**
+ * K-way merge of per-shard pages in ascending list-SK order (UTF-8 byte
+ * order, matching DynamoDB's own key ordering), truncated to `limit`. Each
+ * shard's own order (the GSI's index order) is preserved — SK ties across
+ * shards resolve to the earlier page — so a per-shard resume key taken from
+ * the last emitted item is always consistent with DynamoDB's ordering within
+ * that shard. The merged order is deterministic, and concatenating the pages
+ * of a full pagination walk yields the global ascending list-SK order.
+ *
+ * Returns the merged page plus how many items were consumed (emitted) from
+ * each input page, positionally.
+ */
+const mergeShardPages = (
+  pages: ReadonlyArray<ListPartitionResult>,
+  skField: string,
+  limit: number | undefined,
+): { readonly items: Array<Record<string, unknown>>; readonly consumed: Array<number> } => {
+  const consumed = pages.map(() => 0)
+  const items: Array<Record<string, unknown>> = []
+  while (limit === undefined || items.length < limit) {
+    let best = -1
+    let bestSk: string | undefined
+    for (let index = 0; index < pages.length; index++) {
+      const head = pages[index]?.items[consumed[index] ?? 0]
+      if (head === undefined) continue
+      const sk = String(head[skField])
+      if (bestSk === undefined || utf8Before(sk, bestSk)) {
+        best = index
+        bestSk = sk
+      }
+    }
+    if (best === -1) break
+    const item = pages[best]?.items[consumed[best] ?? 0]
+    if (item === undefined) break
+    items.push(item)
+    consumed[best] = (consumed[best] ?? 0) + 1
+  }
+  return { items, consumed }
+}
