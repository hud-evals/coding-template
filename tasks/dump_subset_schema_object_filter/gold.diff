+// allTableSQL returns the CREATE statement of every table of the database,
+// which is what it takes to stand the original up next to the subset and ask
+// them both the same questions.
+func (db *DB) allTableSQL(ctx context.Context, conn *sql.Conn) ([]string, error) {
+	rows, err := db.queryWithConn(ctx, DumpTablesReq(), false, conn)
+	if err != nil {
+		return nil, err
+	}
+	var out []string
+	for _, v := range rows[0].Values {
+		if strings.HasPrefix(v.Parameters[0].GetS(), "sqlite_") {
+			continue
+		}
+		out = append(out, v.Parameters[2].GetS())
+	}
+	return out, nil
+}
+
+// dumpSequences writes the AUTOINCREMENT counters of the given tables, if any
+// of them have one. It is only used when dumping a subset of the database; a
+// full dump picks sqlite_sequence up as a table like any other.
+func (db *DB) dumpSequences(ctx context.Context, conn *sql.Conn, w io.Writer, tables []string) error {
+	if len(tables) == 0 {
+		return nil
+	}
+
+	// sqlite_sequence only exists once a database has had an AUTOINCREMENT
+	// table created in it, so querying it blind would fail on one which never
+	// has.
+	rows, err := db.queryWithConn(ctx, DumpTablesReq("sqlite_sequence"), false, conn)
+	if err != nil {
+		return err
+	}
+	if len(rows[0].Values) == 0 {
+		return nil
+	}
+
+	rows, err = db.queryWithConn(ctx, DumpSequencesReq(tables...), false, conn)
+	if err != nil {
+		return err
+	}
+	if len(rows[0].Values) == 0 {
+		return nil
+	}
+
+	// The rows dumped above will have set a counter of their own for each
+	// table as they were inserted; clear those before restoring the originals,
+	// which are higher wherever rows have since been deleted.
+	if _, err := w.Write([]byte("DELETE FROM \"sqlite_sequence\";\n")); err != nil {
+		return err
+	}
+	for _, v := range rows[0].Values {
+		if _, err := w.Write(fmt.Appendf(nil, "%s;\n", v.Parameters[0].GetS())); err != nil {
+			return err
+		}
+	}
+	return nil
+}
