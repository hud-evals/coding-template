+// wildSchema is a database made of the shapes a real one grows over the
+// years: syntax SQLite takes but a hand-written reader would not, and objects
+// which stopped working long before anybody thought about backups.
+var wildSchema = []string{
+	`CREATE TABLE keep (id INTEGER PRIMARY KEY, v TEXT)`,
+	`CREATE TABLE keep2 (id INTEGER PRIMARY KEY, v TEXT)`,
+	`CREATE TABLE gone (id INTEGER PRIMARY KEY)`,
+	`INSERT INTO keep VALUES(1, 'a')`,
+	`INSERT INTO keep2 VALUES(1, 'b')`,
+
+	`CREATE VIEW w_brackets AS SELECT id FROM [keep]`,
+	`CREATE VIEW w_over_brackets AS SELECT id FROM w_brackets`,
+	`CREATE VIEW w_from_with AS SELECT x AS id FROM (WITH c(x) AS (SELECT id FROM keep) SELECT x FROM c)`,
+	`CREATE VIEW w_in_with AS SELECT id FROM keep WHERE id IN (WITH c(x) AS (SELECT id FROM keep2) SELECT x FROM c)`,
+	`CREATE VIEW w_scalar_with AS SELECT id, (WITH c(x) AS (SELECT 1) SELECT x FROM c) AS m FROM keep`,
+	`CREATE VIEW w_in_values AS SELECT id FROM keep WHERE id IN (VALUES(1),(2))`,
+	`CREATE VIEW w_right AS SELECT k.id FROM keep k RIGHT JOIN keep2 k2 ON k.id = k2.id`,
+	`CREATE VIEW w_isdistinct AS SELECT id FROM keep WHERE v IS DISTINCT FROM 'x'`,
+	`CREATE VIEW w_underscores AS SELECT id FROM keep WHERE id <> 1_000`,
+	`CREATE VIEW w_agg_order AS SELECT group_concat(v, ',' ORDER BY id) AS id FROM keep`,
+	`CREATE VIEW w_cast_quoted AS SELECT CAST(id AS "TEXT") AS id FROM keep`,
+	`CREATE INDEX w_idx_brackets ON [keep](v)`,
+	`CREATE TRIGGER w_tr_with_ins AFTER INSERT ON keep BEGIN INSERT OR IGNORE INTO keep2(id, v) WITH c(x) AS (SELECT 1) SELECT x, 'z' FROM c; END`,
+	`CREATE TRIGGER w_tr_brackets AFTER UPDATE ON [keep] BEGIN UPDATE keep2 SET v = v; END`,
+}
+
+// Test_DB_DumpSubsetSchemaSQLiteAccepts covers a database written in SQL that
+// is perfectly legal and not at all typical. Every object below needs nothing
+// but the two tables asked for, so every one of them belongs in the backup --
+// however it happens to be spelled.
+func Test_DB_DumpSubsetSchemaSQLiteAccepts(t *testing.T) {
+	db, path := mustCreateOnDiskDatabaseWAL()
+	defer os.Remove(path)
+	defer db.Close()
+	mustLoadStatements(t, db, wildSchema...)
+
+	dump := mustDumpSubset(t, db, "keep", "keep2")
+	newDB, newPath := mustRestore(t, dump)
+	defer os.Remove(newPath)
+	defer newDB.Close()
+
+	exp := `view w_brackets,view w_over_brackets,view w_from_with,view w_in_with,` +
+		`view w_scalar_with,view w_in_values,view w_right,view w_isdistinct,` +
+		`view w_underscores,view w_agg_order,view w_cast_quoted,index w_idx_brackets,` +
+		`trigger w_tr_with_ins,trigger w_tr_brackets`
+	if got := strings.Join(mustSchemaObjects(t, newDB), ","); exp != got {
+		t.Fatalf("unexpected objects\nexp: %s\ngot: %s", exp, got)
+	}
+	if rows, err := newDB.QueryStringStmt(`SELECT count(*) FROM w_over_brackets`); err != nil {
+		t.Fatalf("restored view does not answer: %s", err.Error())
+	} else if e := rows[0].GetError(); e != "" {
+		t.Fatalf("restored view does not answer: %s", e)
+	}
+}
