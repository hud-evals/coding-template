+// Test_DB_DumpSubsetRestoredIsUsable covers the objects whose absence or
+// presence a plain load does not report. A view reaching outside the subset
+// loads without complaint and only fails when it is queried; a trigger writing
+// outside the subset loads without complaint and only fails when the table it
+// hangs on is written to.
+func Test_DB_DumpSubsetRestoredIsUsable(t *testing.T) {
+	db, path := mustCreateOnDiskDatabaseWAL()
+	defer os.Remove(path)
+	defer db.Close()
+	mustLoadStatements(t, db, shopSchema...)
+
+	dump := mustDumpSubset(t, db, "users")
+	newDB, newPath := mustRestore(t, dump)
+	defer os.Remove(newPath)
+	defer newDB.Close()
+
+	for _, v := range []string{"user_names", "user_names_upper", "quoted_users", "main_users", "cte_audit"} {
+		rows, err := newDB.QueryStringStmt(`SELECT * FROM "` + v + `"`)
+		if err != nil {
+			t.Fatalf("failed to query view %s: %s", v, err.Error())
+		}
+		if e := rows[0].GetError(); e != "" {
+			t.Fatalf("failed to query view %s: %s", v, e)
+		}
+	}
+
+	r, err := newDB.ExecuteStringStmt(`INSERT INTO users(name, email) VALUES('carol', 'C@x.com')`)
+	if err != nil {
+		t.Fatalf("failed to write to restored table: %s", err.Error())
+	}
+	if e := r[0].GetError(); e != "" {
+		t.Fatalf("failed to write to restored table: %s", e)
+	}
+
+	rows, err := newDB.QueryStringStmt(`SELECT COUNT(*) FROM users`)
+	if err != nil {
+		t.Fatalf("failed to count rows: %s", err.Error())
+	}
+	if exp, got := `[{"columns":["COUNT(*)"],"types":["integer"],"values":[[3]]}]`, asJSON(rows); exp != got {
+		t.Fatalf("unexpected results for query\nexp: %s\ngot: %s", exp, got)
+	}
+}
