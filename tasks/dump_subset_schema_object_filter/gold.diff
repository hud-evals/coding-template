diff --git a/db/dump_deps.go b/db/dump_deps.go
new file mode 100644
index 0000000..f60f797
--- /dev/null
+++ b/db/dump_deps.go
@@ -0,0 +1,388 @@
+package db
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+	"strings"
+)
+
+// schemaObject is a single row of sqlite_master describing an index, trigger
+// or view.
+type schemaObject struct {
+	Name    string
+	Type    string
+	TblName string
+	SQL     string
+}
+
+// Working out which schema objects a subset dump can carry is not a question
+// about SQL text, so nothing here reads any. It is a question about what a
+// database does, and SQLite answers it: build the database the dump would
+// restore into, ask it the questions the original answers, and keep an object
+// exactly when both databases answer the same way.
+//
+// "The same way" is the whole of it, and it is not the same as "it works". A
+// view whose table was dropped long ago fails in the original too; carrying it
+// keeps the restored database the same as the original, and dropping it would
+// quietly repair a database this code was only asked to copy. So both sides
+// are always run, and their answers compared -- never one side checked for
+// success.
+//
+// Nothing is executed that could change anything: an object's questions are
+// asked by preparing the statement, which is where SQLite resolves a view's
+// tables and a trigger's whole body.
+
+// answer is what a database says when asked to prepare a statement.
+type answer struct {
+	ok  bool
+	err string
+}
+
+func (a answer) equal(b answer) bool { return a.ok == b.ok && a.err == b.err }
+
+func quoteIdent(s string) string { return `"` + strings.ReplaceAll(s, `"`, `""`) + `"` }
+
+// scratch is a throwaway in-memory database.
+type scratch struct {
+	db   *sql.DB
+	conn *sql.Conn
+	ctx  context.Context
+}
+
+func newScratch() (*scratch, error) {
+	drv := DefaultDriver()
+	d, err := sql.Open(drv.Name(), ":memory:")
+	if err != nil {
+		return nil, err
+	}
+	d.SetMaxOpenConns(1)
+	ctx := context.Background()
+	c, err := d.Conn(ctx)
+	if err != nil {
+		d.Close()
+		return nil, err
+	}
+	return &scratch{db: d, conn: c, ctx: ctx}, nil
+}
+
+func (s *scratch) close() {
+	s.conn.Close()
+	s.db.Close()
+}
+
+func (s *scratch) exec(q string) error {
+	_, err := s.conn.ExecContext(s.ctx, q)
+	return err
+}
+
+// ask prepares the statement and reports what SQLite said. The statement is
+// never run.
+func (s *scratch) ask(q string) answer {
+	st, err := s.conn.PrepareContext(s.ctx, q)
+	if err != nil {
+		return answer{ok: false, err: err.Error()}
+	}
+	st.Close()
+	return answer{ok: true}
+}
+
+func (s *scratch) askAll(stmts []string) []answer {
+	out := make([]answer, 0, len(stmts))
+	for _, q := range stmts {
+		out = append(out, s.ask(q))
+	}
+	return out
+}
+
+func sameAnswers(a, b []answer) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if !a[i].equal(b[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+// exists reports whether the database holds a table or view of that name.
+func (s *scratch) exists(name string) bool {
+	rows, err := s.conn.QueryContext(s.ctx,
+		`SELECT count(*) FROM sqlite_master WHERE name = ? AND type IN ('table','view')`, name)
+	if err != nil {
+		return false
+	}
+	defer rows.Close()
+	n := 0
+	if rows.Next() {
+		if err := rows.Scan(&n); err != nil {
+			return false
+		}
+	}
+	return n > 0
+}
+
+// columns names the columns of a table or view, in order, with the first one
+// that is not part of the primary key first in the second return value.
+func (s *scratch) columns(name string) (all []string, plain []string) {
+	rows, err := s.conn.QueryContext(s.ctx, fmt.Sprintf("PRAGMA table_info(%s)", quoteIdent(name)))
+	if err != nil {
+		return nil, nil
+	}
+	defer rows.Close()
+	for rows.Next() {
+		var cid, notnull, pk int
+		var nm, typ string
+		var dflt any
+		if err := rows.Scan(&cid, &nm, &typ, &notnull, &dflt, &pk); err != nil {
+			return all, plain
+		}
+		all = append(all, nm)
+		if pk == 0 {
+			plain = append(plain, nm)
+		}
+	}
+	return all, plain
+}
+
+// probeStatements are the three writes whose preparation resolves every
+// trigger hanging on the target. They are worked out once, on the original, so
+// that both databases are asked the very same questions.
+func (s *scratch) probeStatements(target string) []string {
+	q := quoteIdent(target)
+	out := []string{
+		fmt.Sprintf("INSERT INTO %s SELECT * FROM %s WHERE 0", q, q),
+		fmt.Sprintf("DELETE FROM %s WHERE 0", q),
+	}
+	all, plain := s.columns(target)
+	if len(plain) == 0 {
+		plain = all
+	}
+	if len(plain) > 0 {
+		c := quoteIdent(plain[0])
+		out = append(out, fmt.Sprintf("UPDATE %s SET %s = %s WHERE 0", q, c, c))
+	}
+	return out
+}
+
+// build makes a scratch database holding the given tables and objects.
+//
+// A table that will not create is skipped when tolerant is set -- that is the
+// original, where a virtual table this code does not handle is none of its
+// business -- and is an error otherwise. The name of the first object that
+// would not create is returned; the caller decides what that means.
+func build(tableSQL []string, objs []schemaObject, tolerant bool) (*scratch, string, error) {
+	s, err := newScratch()
+	if err != nil {
+		return nil, "", err
+	}
+	for _, t := range tableSQL {
+		if err := s.exec(t); err != nil && !tolerant {
+			s.close()
+			return nil, "", err
+		}
+	}
+	for _, o := range objs {
+		if err := s.exec(o.SQL); err != nil {
+			if tolerant {
+				continue
+			}
+			s.close()
+			return nil, o.Name, nil
+		}
+	}
+	return s, "", nil
+}
+
+func nonTriggers(objs []schemaObject) []schemaObject {
+	out := make([]schemaObject, 0, len(objs))
+	for _, o := range objs {
+		if !strings.EqualFold(o.Type, "trigger") {
+			out = append(out, o)
+		}
+	}
+	return out
+}
+
+// original holds what the database being dumped answers, so that the database
+// the dump would restore into can be held to the same answers.
+type original struct {
+	views    map[string]answer   // SELECT * FROM <view>
+	trigStmt map[string][]string // trigger name -> the questions asked of its table
+	trigAns  map[string][]answer // trigger name -> the original's answers
+	tables   map[string][]string // requested table -> the questions asked of it
+	tableAns map[string][]answer
+}
+
+func readOriginal(allTableSQL []string, objs []schemaObject, tables []string) (*original, error) {
+	o := &original{
+		views:    map[string]answer{},
+		trigStmt: map[string][]string{},
+		trigAns:  map[string][]answer{},
+		tables:   map[string][]string{},
+		tableAns: map[string][]answer{},
+	}
+
+	whole, _, err := build(allTableSQL, objs, true)
+	if err != nil {
+		return nil, err
+	}
+	for _, ob := range objs {
+		if strings.EqualFold(ob.Type, "view") {
+			o.views[ob.Name] = whole.ask(fmt.Sprintf("SELECT * FROM %s", quoteIdent(ob.Name)))
+		}
+	}
+	for _, t := range tables {
+		stmts := whole.probeStatements(t)
+		o.tables[t] = stmts
+		o.tableAns[t] = whole.askAll(stmts)
+	}
+	whole.close()
+
+	// Each trigger is asked about on an original stripped to that one trigger,
+	// and will be answered on a restored database stripped the same way. A
+	// trigger left behind for its own good reasons must never be the reason
+	// its neighbour looks broken.
+	others := nonTriggers(objs)
+	for _, ob := range objs {
+		if !strings.EqualFold(ob.Type, "trigger") {
+			continue
+		}
+		iso, bad, err := build(allTableSQL, append(append([]schemaObject(nil), others...), ob), true)
+		if err != nil {
+			return nil, err
+		}
+		if bad != "" || !iso.exists(ob.TblName) {
+			iso.close()
+			continue
+		}
+		stmts := iso.probeStatements(ob.TblName)
+		o.trigStmt[ob.Name] = stmts
+		o.trigAns[ob.Name] = iso.askAll(stmts)
+		iso.close()
+	}
+	return o, nil
+}
+
+// probeSchemaObjects returns the objects a dump of the given tables can carry:
+// the largest set for which the restored database answers exactly as the
+// original does.
+func probeSchemaObjects(objs []schemaObject, tables []string, tableSQL []string,
+	allTableSQL []string) []schemaObject {
+	orig, err := readOriginal(allTableSQL, objs, tables)
+	if err != nil {
+		// Nothing can be established about this database, so nothing is
+		// claimed about it: better a dump that carries only the tables than
+		// one that will not restore.
+		return nil
+	}
+
+	kept := append([]schemaObject(nil), objs...)
+	drop := func(name string) {
+		out := kept[:0]
+		for _, o := range kept {
+			if o.Name != name {
+				out = append(out, o)
+			}
+		}
+		kept = out
+	}
+
+	for {
+		s, bad, err := build(tableSQL, kept, false)
+		if err != nil {
+			return nil
+		}
+		if bad != "" {
+			// It will not even create without the tables that were left out.
+			drop(bad)
+			continue
+		}
+
+		for _, o := range kept {
+			if !strings.EqualFold(o.Type, "view") {
+				continue
+			}
+			if !s.ask(fmt.Sprintf("SELECT * FROM %s", quoteIdent(o.Name))).equal(orig.views[o.Name]) {
+				bad = o.Name
+				break
+			}
+		}
+		s.close()
+		if bad != "" {
+			drop(bad)
+			continue
+		}
+
+		others := nonTriggers(kept)
+		for _, o := range kept {
+			if !strings.EqualFold(o.Type, "trigger") {
+				continue
+			}
+			iso, b, err := build(tableSQL, append(append([]schemaObject(nil), others...), o), false)
+			if err != nil {
+				return nil
+			}
+			if b != "" {
+				iso.close()
+				bad = o.Name
+				break
+			}
+			stmts, known := orig.trigStmt[o.Name]
+			if known && !sameAnswers(iso.askAll(stmts), orig.trigAns[o.Name]) {
+				bad = o.Name
+			}
+			iso.close()
+			if bad != "" {
+				break
+			}
+		}
+		if bad != "" {
+			drop(bad)
+			continue
+		}
+
+		// With everything that survived in place, the requested tables must
+		// still answer as they did. They can only have got worse -- a trigger
+		// that was left behind cannot make them refuse anything -- so a
+		// difference in that direction is charged to a trigger on that table.
+		s, b, err := build(tableSQL, kept, false)
+		if err != nil {
+			return nil
+		}
+		if b != "" {
+			drop(b)
+			continue
+		}
+		for _, t := range tables {
+			got := s.askAll(orig.tables[t])
+			want := orig.tableAns[t]
+			worse := false
+			for i := range got {
+				if i < len(want) && !got[i].ok && want[i].ok {
+					worse = true
+				}
+			}
+			if !worse {
+				continue
+			}
+			for _, o := range kept {
+				if strings.EqualFold(o.Type, "trigger") && strings.EqualFold(o.TblName, t) {
+					bad = o.Name
+					break
+				}
+			}
+			if bad != "" {
+				break
+			}
+		}
+		s.close()
+		if bad != "" {
+			drop(bad)
+			continue
+		}
+		return kept
+	}
+}
