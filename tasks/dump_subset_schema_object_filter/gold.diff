+// DumpObjectsReq returns a command.Request that will dump the indexes,
+// triggers and views of a database.
+func DumpObjectsReq() *command.Request {
+	return &command.Request{
+		Statements: []*command.Statement{
+			{
+				Sql: `SELECT "name", "type", "tbl_name", "sql" FROM "sqlite_master" WHERE "sql" NOT NULL AND "type" IN ('index', 'trigger', 'view')`,
+			},
+		},
+	}
+}
+
+// DumpSequencesReq returns a command.Request that will produce the INSERT
+// statements which restore the AUTOINCREMENT counters of the given tables.
+// This form protects against SQL injection by using parameterized queries.
+func DumpSequencesReq(tables ...string) *command.Request {
+	var sb strings.Builder
+	sb.WriteString(`SELECT 'INSERT INTO "sqlite_sequence" VALUES('||quote("name")||','||quote("seq")||')' FROM "sqlite_sequence" WHERE "name" IN (`)
+	for i := range tables {
+		if i > 0 {
+			sb.WriteString(", ")
+		}
+		sb.WriteString("?")
+	}
+	sb.WriteString(") ORDER BY name")
+
+	parameters := make([]*command.Parameter, len(tables))
+	for i, table := range tables {
+		parameters[i] = &command.Parameter{
+			Value: &command.Parameter_S{
+				S: table,
+			},
+		}
+	}
+
+	return &command.Request{
+		Statements: []*command.Statement{
+			{
+				Sql:        sb.String(),
+				Parameters: parameters,
+			},
+		},
+	}
+}
