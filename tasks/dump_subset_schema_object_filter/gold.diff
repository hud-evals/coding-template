@@ -0,0 +1,560 @@
+package db
+
+import (
+	"os"
+	"strings"
+	"testing"
+)
+
+// mustLoadStatements executes each statement in turn, failing on the first
+// error.
+func mustLoadStatements(t *testing.T, db *DB, stmts ...string) {
+	t.Helper()
+	for _, s := range stmts {
+		r, err := db.ExecuteStringStmt(s)
+		if err != nil {
+			t.Fatalf("failed to execute %q: %s", s, err.Error())
+		}
+		for _, x := range r {
+			if e := x.GetError(); e != "" {
+				t.Fatalf("failed to execute %q: %s", s, e)
+			}
+		}
+	}
+}
+
+// mustRestore loads a dump into a fresh database, failing if anything in it is
+// rejected. The caller is responsible for closing and removing the result.
+func mustRestore(t *testing.T, dump string) (*DB, string) {
+	t.Helper()
+	db, path := mustCreateOnDiskDatabase()
+	r, err := db.ExecuteStringStmt(dump)
+	if err != nil {
+		t.Fatalf("failed to load dump: %s\n%s", err.Error(), dump)
+	}
+	for _, x := range r {
+		if e := x.GetError(); e != "" {
+			t.Fatalf("failed to load dump: %s\n%s", e, dump)
+		}
+	}
+	return db, path
+}
+
+// mustSchemaObjects returns the indexes, triggers and views of a database,
+// as "type name" strings in the order sqlite_master holds them.
+func mustSchemaObjects(t *testing.T, db *DB) []string {
+	t.Helper()
+	rows, err := db.QueryStringStmt(`SELECT "type" || ' ' || "name" FROM sqlite_master
+		WHERE "type" IN ('index', 'trigger', 'view') AND "sql" NOT NULL
+		  AND "name" NOT LIKE 'sqlite^_%' ESCAPE '^'`)
+	if err != nil {
+		t.Fatalf("failed to read schema: %s", err.Error())
+	}
+	if e := rows[0].GetError(); e != "" {
+		t.Fatalf("failed to read schema: %s", e)
+	}
+	var out []string
+	for _, v := range rows[0].Values {
+		out = append(out, v.Parameters[0].GetS())
+	}
+	return out
+}
+
+// mustDumpSubset dumps the given tables from db.
+func mustDumpSubset(t *testing.T, db *DB, tables ...string) string {
+	t.Helper()
+	var buf strings.Builder
+	if err := db.Dump(&buf, tables...); err != nil {
+		t.Fatalf("failed to dump: %s", err.Error())
+	}
+	return buf.String()
+}
+
+// shopSchema is a database with every kind of schema object hanging off two
+// groups of tables, so that a subset of it leaves some of them behind.
+var shopSchema = []string{
+	`CREATE TABLE users (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, email TEXT)`,
+	`CREATE TABLE audit (id INTEGER PRIMARY KEY, msg TEXT)`,
+	`CREATE INDEX idx_users_named ON users(name) WHERE name IS NOT NULL`,
+	`CREATE INDEX idx_users_email_lower ON users(lower(email))`,
+	`CREATE INDEX idx_audit_msg ON audit(msg)`,
+	`CREATE VIEW user_names AS SELECT id, name FROM users`,
+	`CREATE VIEW user_names_upper AS SELECT id, upper(name) AS name FROM user_names`,
+	`CREATE VIEW audit_view AS SELECT msg FROM audit`,
+	`CREATE VIEW user_audit AS SELECT name, (SELECT count(*) FROM audit) AS n FROM users`,
+	`CREATE VIEW quoted_users AS SELECT name FROM "users"`,
+	`CREATE VIEW main_users AS SELECT name FROM main.users`,
+	`CREATE VIEW cte_audit AS WITH audit AS (SELECT 1 AS n) SELECT n FROM audit`,
+	`CREATE TRIGGER users_audit AFTER INSERT ON users BEGIN INSERT INTO audit(msg) VALUES('user'); END`,
+	`CREATE TRIGGER on_view INSTEAD OF INSERT ON user_names BEGIN INSERT INTO users(name) VALUES(NEW.name); END`,
+	`INSERT INTO users(name, email) VALUES('alice', 'A@x.com'), ('bob', 'B@x.com')`,
+	`DELETE FROM audit`,
+	`INSERT INTO audit(id, msg) VALUES(1, 'created')`,
+}
+
+// Test_DB_DumpSubsetObjects covers which schema objects a subset dump carries.
+// An object comes along when everything it needs is in the subset, and is left
+// behind when it is not -- including the cases where the reference is not where
+// the object's own name suggests it is.
+func Test_DB_DumpSubsetObjects(t *testing.T) {
+	db, path := mustCreateOnDiskDatabaseWAL()
+	defer os.Remove(path)
+	defer db.Close()
+	mustLoadStatements(t, db, shopSchema...)
+
+	tests := []struct {
+		name   string
+		tables []string
+		want   string
+	}{
+		{
+			// Indexes on a table in the subset come along, partial and
+			// expression indexes included; the index on the table left behind
+			// does not. A view on a view comes along with its base, and a
+			// trigger on a view that came along comes along too. A reference
+			// through quotes or through main. is the same reference. A name
+			// defined by a CTE is not a table at all, so the view using it
+			// needs nothing.
+			name:   "subset of the tables",
+			tables: []string{"users"},
+			want: `index idx_users_named,index idx_users_email_lower,` +
+				`view user_names,view user_names_upper,view quoted_users,view main_users,view cte_audit,` +
+				`trigger on_view`,
+		},
+		{
+			// Everything is in the subset, so nothing may be dropped: the
+			// correct answer here is to carry the whole schema.
+			name:   "all of the tables",
+			tables: []string{"users", "audit"},
+			want: `index idx_users_named,index idx_users_email_lower,index idx_audit_msg,` +
+				`view user_names,view user_names_upper,view audit_view,view user_audit,` +
+				`view quoted_users,view main_users,view cte_audit,` +
+				`trigger users_audit,trigger on_view`,
+		},
+		{
+			// Nothing hangs off audit alone: user_audit reaches back to users
+			// and audit_view's own table is here, so only the objects needing
+			// nothing survive.
+			name:   "the other subset",
+			tables: []string{"audit"},
+			want:   `index idx_audit_msg,view audit_view,view cte_audit`,
+		},
+		{
+			// No table matched, so nothing is there to be referred to.
+			name:   "no such table",
+			tables: []string{"nosuch"},
+			want:   `view cte_audit`,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			dump := mustDumpSubset(t, db, tc.tables...)
+			newDB, newPath := mustRestore(t, dump)
+			defer os.Remove(newPath)
+			defer newDB.Close()
+
+			if exp, got := tc.want, strings.Join(mustSchemaObjects(t, newDB), ","); exp != got {
+				t.Fatalf("unexpected schema objects\nexp: %s\ngot: %s", exp, got)
+			}
+		})
+	}
+}
