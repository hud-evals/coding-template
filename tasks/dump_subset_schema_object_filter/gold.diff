+// Test_DB_DumpFullUnchanged covers the case where doing nothing is right: a
+// dump with no tables named is the whole database, warts and all, and none of
+// the filtering above may touch it.
+func Test_DB_DumpFullUnchanged(t *testing.T) {
+	db, path := mustCreateOnDiskDatabaseWAL()
+	defer os.Remove(path)
+	defer db.Close()
+	mustLoadStatements(t, db,
+		`CREATE TABLE users (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT)`,
+		`CREATE TABLE audit (id INTEGER PRIMARY KEY, msg TEXT)`,
+		`CREATE INDEX idx_audit_msg ON audit(msg)`,
+		`CREATE VIEW audit_view AS SELECT msg FROM audit`,
+		`CREATE TRIGGER users_audit AFTER INSERT ON users BEGIN INSERT INTO audit(msg) VALUES('user'); END`,
+		`INSERT INTO users(name) VALUES('alice')`,
+		`DELETE FROM audit`,
+	)
+
+	// Two warts are pinned here on purpose. The tables are written in name
+	// order, so sqlite_sequence lands before the AUTOINCREMENT table it
+	// belongs to; and its statement already ends in a semicolon, so a second
+	// one is written after it. Both are how a full dump has always come out.
+	exp := `PRAGMA foreign_keys=OFF;
+BEGIN TRANSACTION;
+CREATE TABLE audit (id INTEGER PRIMARY KEY, msg TEXT);
+DELETE FROM "sqlite_sequence";;
+INSERT INTO "sqlite_sequence" VALUES('users',1);
+CREATE TABLE users (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT);
+INSERT INTO "users" VALUES(1,'alice');
+CREATE INDEX idx_audit_msg ON audit(msg);
+CREATE VIEW audit_view AS SELECT msg FROM audit;
+CREATE TRIGGER users_audit AFTER INSERT ON users BEGIN INSERT INTO audit(msg) VALUES('user'); END;
+COMMIT;
+`
+	if got := mustDumpSubset(t, db); exp != got {
+		t.Fatalf("unexpected full dump\nexp:\n%s\ngot:\n%s", exp, got)
+	}
+}
