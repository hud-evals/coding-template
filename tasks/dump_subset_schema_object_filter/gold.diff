+// Test_DB_DumpSubsetObjectOrder covers the order the surviving objects are
+// written in: a view built on a view has to be created after its base, which
+// is the order sqlite_master already holds them in.
+func Test_DB_DumpSubsetObjectOrder(t *testing.T) {
+	db, path := mustCreateOnDiskDatabaseWAL()
+	defer os.Remove(path)
+	defer db.Close()
+	mustLoadStatements(t, db,
+		`CREATE TABLE a (id INTEGER PRIMARY KEY, w TEXT)`,
+		`CREATE TABLE b (id INTEGER PRIMARY KEY, z TEXT)`,
+		`CREATE VIEW v1 AS SELECT id, w FROM a`,
+		`CREATE VIEW v2 AS SELECT id, w FROM v1`,
+		`CREATE VIEW v3 AS SELECT v2.id, v2.w FROM v2 JOIN v1 ON v1.id = v2.id`,
+		`CREATE VIEW vb AS SELECT v1.w, b.z FROM v1 JOIN b ON b.id = v1.id`,
+		`CREATE TRIGGER t_on_v3 INSTEAD OF INSERT ON v3 BEGIN INSERT INTO a(w) VALUES(NEW.w); END`,
+	)
+
+	dump := mustDumpSubset(t, db, "a")
+	for _, s := range []string{"vb"} {
+		if strings.Contains(dump, s) {
+			t.Fatalf("dump should not mention %s\n%s", s, dump)
+		}
+	}
+	var order []string
+	for _, line := range strings.Split(dump, "\n") {
+		for _, s := range []string{"v1", "v2", "v3", "t_on_v3"} {
+			if strings.HasPrefix(line, "CREATE VIEW "+s+" ") || strings.HasPrefix(line, "CREATE TRIGGER "+s+" ") {
+				order = append(order, s)
+			}
+		}
+	}
+	if exp, got := "v1,v2,v3,t_on_v3", strings.Join(order, ","); exp != got {
+		t.Fatalf("unexpected order of objects\nexp: %s\ngot: %s\n%s", exp, got, dump)
+	}
+
+	newDB, newPath := mustRestore(t, dump)
+	defer os.Remove(newPath)
+	defer newDB.Close()
+	rows, err := newDB.QueryStringStmt(`SELECT COUNT(*) FROM v3`)
+	if err != nil {
+		t.Fatalf("failed to query restored view: %s", err.Error())
+	}
+	if e := rows[0].GetError(); e != "" {
+		t.Fatalf("failed to query restored view: %s", e)
+	}
+}
