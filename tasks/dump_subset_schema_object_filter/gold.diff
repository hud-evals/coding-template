+// Test_DB_DumpSubsetSequences covers the AUTOINCREMENT counters. Restoring a
+// subset must not change what the database does next, and must not carry the
+// counters of tables which were not asked for.
+func Test_DB_DumpSubsetSequences(t *testing.T) {
+	db, path := mustCreateOnDiskDatabaseWAL()
+	defer os.Remove(path)
+	defer db.Close()
+	mustLoadStatements(t, db,
+		`CREATE TABLE alpha (id INTEGER PRIMARY KEY AUTOINCREMENT, v TEXT)`,
+		`CREATE TABLE zebra (id INTEGER PRIMARY KEY AUTOINCREMENT, v TEXT)`,
+		`CREATE TABLE plain (id INTEGER PRIMARY KEY, v TEXT)`,
+		`INSERT INTO alpha(v) VALUES('a1'), ('a2'), ('a3')`,
+		`INSERT INTO zebra(v) VALUES('z1'), ('z2')`,
+		`INSERT INTO plain VALUES(1, 'p1')`,
+		`DELETE FROM alpha WHERE id > 1`,
+		`DELETE FROM zebra WHERE id > 1`,
+	)
+
+	tests := []struct {
+		name    string
+		tables  []string
+		wantSeq string
+		insert  string
+		into    string
+		wantKey string
+	}{
+		{
+			name:    "table sorting after sqlite_sequence",
+			tables:  []string{"zebra"},
+			wantSeq: `[{"columns":["name","seq"],"types":["text","integer"],"values":[["zebra",2]]}]`,
+			insert:  `INSERT INTO zebra(v) VALUES('z3')`,
+			into:    "zebra",
+			wantKey: `[{"columns":["MAX(id)"],"types":["integer"],"values":[[3]]}]`,
+		},
+		{
+			name:    "counter of one table only",
+			tables:  []string{"alpha"},
+			wantSeq: `[{"columns":["name","seq"],"types":["text","integer"],"values":[["alpha",3]]}]`,
+			insert:  `INSERT INTO alpha(v) VALUES('a4')`,
+			into:    "alpha",
+			wantKey: `[{"columns":["MAX(id)"],"types":["integer"],"values":[[4]]}]`,
+		},
+		{
+			name:   "no counters wanted",
+			tables: []string{"plain"},
+			// sqlite_sequence is never created, so it cannot be read.
+			wantSeq: `[{"error":"no such table: sqlite_sequence"}]`,
+		},
+		{
+			name:    "counters of both, and of nothing else",
+			tables:  []string{"alpha", "zebra"},
+			wantSeq: `[{"columns":["name","seq"],"types":["text","integer"],"values":[["alpha",3],["zebra",2]]}]`,
+			insert:  `INSERT INTO alpha(v) VALUES('a4')`,
+			into:    "alpha",
+			wantKey: `[{"columns":["MAX(id)"],"types":["integer"],"values":[[4]]}]`,
+		},
+		{
+			name:    "a table with counters and one without",
+			tables:  []string{"plain", "zebra"},
+			wantSeq: `[{"columns":["name","seq"],"types":["text","integer"],"values":[["zebra",2]]}]`,
+			insert:  `INSERT INTO zebra(v) VALUES('z3')`,
+			into:    "zebra",
+			wantKey: `[{"columns":["MAX(id)"],"types":["integer"],"values":[[3]]}]`,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			dump := mustDumpSubset(t, db, tc.tables...)
+			newDB, newPath := mustRestore(t, dump)
+			defer os.Remove(newPath)
+			defer newDB.Close()
+
+			rows, err := newDB.QueryStringStmt(`SELECT name, seq FROM sqlite_sequence ORDER BY name`)
+			if err != nil {
+				t.Fatalf("failed to read counters: %s", err.Error())
+			}
+			if exp, got := tc.wantSeq, asJSON(rows); exp != got {
+				t.Fatalf("unexpected counters\nexp: %s\ngot: %s\n%s", exp, got, dump)
+			}
+			if tc.insert == "" {
+				return
+			}
+
+			r, err := newDB.ExecuteStringStmt(tc.insert)
+			if err != nil {
+				t.Fatalf("failed to insert: %s", err.Error())
+			}
+			if e := r[0].GetError(); e != "" {
+				t.Fatalf("failed to insert: %s", e)
+			}
+			rows, err = newDB.QueryStringStmt(`SELECT MAX(id) FROM "` + tc.into + `"`)
+			if err != nil {
+				t.Fatalf("failed to read key: %s", err.Error())
+			}
+			if exp, got := tc.wantKey, asJSON(rows); exp != got {
+				t.Fatalf("unexpected key for next row\nexp: %s\ngot: %s", exp, got)
+			}
+		})
+	}
+}
