+// Test_DB_DumpSubsetCarriesWhatWasAlreadyBroken covers the objects a live
+// database collects and never notices: a view whose table was dropped under
+// it, a view naming a column that is not there, a DELETE trigger reading NEW.
+// Each of them fails in the original, and each has to fail in the same way
+// after a restore -- a backup copies a database, it does not repair one.
+func Test_DB_DumpSubsetCarriesWhatWasAlreadyBroken(t *testing.T) {
+	db, path := mustCreateOnDiskDatabaseWAL()
+	defer os.Remove(path)
+	defer db.Close()
+	mustLoadStatements(t, db,
+		`CREATE TABLE keep (id INTEGER PRIMARY KEY, v TEXT)`,
+		`CREATE TABLE other (id INTEGER PRIMARY KEY)`,
+		`CREATE TABLE gone (id INTEGER PRIMARY KEY)`,
+		`INSERT INTO keep VALUES(1, 'a')`,
+		`CREATE VIEW b_dangling AS SELECT id FROM gone`,
+		`CREATE VIEW b_over_dangling AS SELECT id FROM b_dangling`,
+		`CREATE VIEW b_badcol AS SELECT nosuch FROM keep`,
+		`CREATE TRIGGER b_new_in_delete AFTER DELETE ON keep BEGIN UPDATE keep SET v = NEW.v; END`,
+		`CREATE VIEW b_leak AS SELECT id FROM other`,
+		`DROP TABLE gone`,
+	)
+
+	// What the original says when asked. It is not much, and that is the point.
+	origDelete := errorOf(t, db, `DELETE FROM keep WHERE 0`)
+	origView := errorOf(t, db, `SELECT * FROM b_dangling`)
+	if origDelete == "" || origView == "" {
+		t.Fatalf("this database was supposed to be broken already: %q %q", origDelete, origView)
+	}
+
+	dump := mustDumpSubset(t, db, "keep")
+	newDB, newPath := mustRestore(t, dump)
+	defer os.Remove(newPath)
+	defer newDB.Close()
+
+	exp := "view b_dangling,view b_over_dangling,view b_badcol,trigger b_new_in_delete"
+	if got := strings.Join(mustSchemaObjects(t, newDB), ","); exp != got {
+		t.Fatalf("unexpected objects\nexp: %s\ngot: %s", exp, got)
+	}
+	if got := errorOf(t, newDB, `DELETE FROM keep WHERE 0`); got != origDelete {
+		t.Fatalf("restored database answers %q, the original answers %q", got, origDelete)
+	}
+	if got := errorOf(t, newDB, `SELECT * FROM b_dangling`); got != origView {
+		t.Fatalf("restored database answers %q, the original answers %q", got, origView)
+	}
+}
+
+// errorOf returns the error a statement produces, or "" if it produces none.
+func errorOf(t *testing.T, db *DB, stmt string) string {
+	t.Helper()
+	r, err := db.ExecuteStringStmt(stmt)
+	if err != nil {
+		return err.Error()
+	}
+	for _, x := range r {
+		if e := x.GetError(); e != "" {
+			return e
+		}
+	}
+	return ""
+}
