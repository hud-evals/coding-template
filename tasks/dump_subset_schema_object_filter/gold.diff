+// Test_DB_DumpSubsetNothingToFilter covers the other case where doing nothing
+// is right: a database whose whole schema is tables has no objects to leave
+// behind, and a subset of it is just its tables.
+func Test_DB_DumpSubsetNothingToFilter(t *testing.T) {
+	db, path := mustCreateOnDiskDatabaseWAL()
+	defer os.Remove(path)
+	defer db.Close()
+	mustLoadStatements(t, db,
+		`CREATE TABLE foo (id INTEGER PRIMARY KEY, name TEXT)`,
+		`CREATE TABLE bar (id INTEGER PRIMARY KEY, age INTEGER)`,
+		`INSERT INTO foo VALUES(1, 'fiona')`,
+		`INSERT INTO bar VALUES(1, 25)`,
+	)
+
+	exp := `PRAGMA foreign_keys=OFF;
+BEGIN TRANSACTION;
+CREATE TABLE foo (id INTEGER PRIMARY KEY, name TEXT);
+INSERT INTO "foo" VALUES(1,'fiona');
+COMMIT;
+`
+	if got := mustDumpSubset(t, db, "foo"); exp != got {
+		t.Fatalf("unexpected dump\nexp:\n%s\ngot:\n%s", exp, got)
+	}
+}
