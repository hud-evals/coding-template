index 0000000..9f5d4c0
--- /dev/null
+++ b/lib/route-concurrency.js
@@ -0,0 +1,87 @@
+'use strict'
+
+const {
+  FST_ERR_ROUTE_CONCURRENCY_QUEUE_FULL,
+  FST_ERR_ROUTE_CONCURRENCY_QUEUE_TIMEOUT
+} = require('./errors')
+const { kReplyIsError } = require('./symbols.js')
+
+// Per-route admission state. One instance per Context (route); routes without
+// the option never construct one and keep the original fast path.
+class RouteConcurrency {
+  constructor ({ max, queueLimit, queueTimeout }) {
+    this.max = max
+    this.queueLimit = queueLimit
+    this.queueTimeout = queueTimeout
+    this.active = 0
+    this.queue = []
+  }
+
+  admit (request, reply, run) {
+    if (this.active < this.max) {
+      this._start(request, reply, run)
+      return
+    }
+
+    if (this.queue.length >= this.queueLimit) {
+      rejectWith(reply, new FST_ERR_ROUTE_CONCURRENCY_QUEUE_FULL(request.url))
+      return
+    }
+
+    const entry = { request, reply, run, timer: null, onClose: null }
+    entry.timer = setTimeout(() => {
+      this._dequeue(entry)
+      rejectWith(reply, new FST_ERR_ROUTE_CONCURRENCY_QUEUE_TIMEOUT(this.queueTimeout, request.url))
+    }, this.queueTimeout)
+    // A queued client that goes away is dropped without ever taking a slot.
+    entry.onClose = () => { this._dequeue(entry) }
+    request.raw.on('close', entry.onClose)
+    this.queue.push(entry)
+  }
+
+  _dequeue (entry) {
+    const index = this.queue.indexOf(entry)
+    if (index === -1) return false
+    this.queue.splice(index, 1)
+    clearTimeout(entry.timer)
+    entry.request.raw.removeListener('close', entry.onClose)
+    return true
+  }
+
+  _start (request, reply, run) {
+    this.active++
+    const res = reply.raw
+    let released = false
+    const release = () => {
+      if (released) return
+      released = true
+      res.removeListener('finish', release)
+      res.removeListener('close', release)
+      res.removeListener('error', release)
+      this.active--
+      this._drain()
+    }
+    // 'finish' covers normal completion, 'close' covers client disconnect
+    // mid-stream (including hijacked replies) and 'error' covers write errors.
+    res.on('finish', release)
+    res.on('close', release)
+    res.on('error', release)
+    run()
+  }
+
+  _drain () {
+    while (this.active < this.max && this.queue.length > 0) {
+      const entry = this.queue.shift()
+      clearTimeout(entry.timer)
+      entry.request.raw.removeListener('close', entry.onClose)
+      this._start(entry.request, entry.reply, entry.run)
+    }
+  }
+}
+
+function rejectWith (reply, error) {
+  reply[kReplyIsError] = true
+  reply.send(error)
+}
+
+module.exports = RouteConcurrency
