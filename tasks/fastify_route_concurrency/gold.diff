diff --git a/test/route-concurrency.test.js b/test/route-concurrency.test.js
new file mode 100644
index 0000000..1385576
--- /dev/null
+++ b/test/route-concurrency.test.js
@@ -0,0 +1,184 @@
+'use strict'
+
+const { test } = require('node:test')
+const http = require('node:http')
+const { Readable } = require('node:stream')
+const Fastify = require('..')
+
+function deferred () {
+  let release
+  const promise = new Promise(resolve => { release = resolve })
+  return { promise, resolve: release }
+}
+
+function delay (ms) {
+  return new Promise(resolve => setTimeout(resolve, ms))
+}
+
+async function waitFor (predicate, ms = 1000) {
+  const deadline = Date.now() + ms
+  while (!predicate()) {
+    if (Date.now() >= deadline) throw new Error('condition timed out')
+    await delay(2)
+  }
+}
+
+// --- Option validation ---
+
+test('invalid concurrency options fail registration with FST_ERR_ROUTE_CONCURRENCY_OPTION_INVALID', t => {
+  const invalid = [null, [], {}, { max: 0 }, { max: 1.5 }, { max: '1' },
+    { max: 1, queueLimit: -1 }, { max: 1, queueTimeout: 0 }, { max: 1, queueTimeout: '5000' }]
+  t.plan(invalid.length * 2)
+  for (const concurrency of invalid) {
+    const fastify = Fastify()
+    t.assert.throws(() => {
+      fastify.get('/', { concurrency }, async () => 'ok')
+    }, err => {
+      t.assert.ok(err instanceof TypeError)
+      return err.code === 'FST_ERR_ROUTE_CONCURRENCY_OPTION_INVALID'
+    })
+  }
+})
+
+test('request.routeOptions.concurrency is the normalized object, undefined without the option', async t => {
+  t.plan(4)
+  const fastify = Fastify()
+  fastify.get('/limited', { concurrency: { max: 2 } }, async request => request.routeOptions.concurrency)
+  fastify.get('/plain', async request => ({ value: request.routeOptions.concurrency }))
+  fastify.register(async instance => {
+    instance.get('/inherited', async request => request.routeOptions.concurrency)
+    instance.get('/overridden', { concurrency: { max: 1, queueTimeout: 500 } }, async request => request.routeOptions.concurrency)
+  }, { prefix: '/plugin', concurrency: { max: 3, queueLimit: 4 } })
+
+  t.assert.deepStrictEqual((await fastify.inject('/limited')).json(), { max: 2, queueLimit: 0, queueTimeout: 30000 })
+  t.assert.deepStrictEqual((await fastify.inject('/plain')).json(), {})
+  t.assert.deepStrictEqual((await fastify.inject('/plugin/inherited')).json(), { max: 3, queueLimit: 4, queueTimeout: 30000 })
+  t.assert.deepStrictEqual((await fastify.inject('/plugin/overridden')).json(), { max: 1, queueLimit: 0, queueTimeout: 500 })
+})
+
+// --- Admission ---
+
+test('admits at most max requests, queues the rest in FIFO order, rejects beyond queueLimit', async t => {
+  t.plan(5)
+  const fastify = Fastify()
+  const gate = deferred()
+  const started = []
+  const hooks = []
+
+  fastify.get('/:id', {
+    concurrency: { max: 1, queueLimit: 2, queueTimeout: 2000 },
+    onRequest: async request => { hooks.push(request.params.id) }
+  }, async request => {
+    started.push(request.params.id)
+    if (request.params.id === 'first') await gate.promise
+    return request.params.id
+  })
+
+  const first = fastify.inject('/first')
+  await waitFor(() => started.length === 1)
+  const second = fastify.inject('/second')
+  const third = fastify.inject('/third')
+  await delay(10)
+  const rejected = await fastify.inject('/rejected')
+
+  t.assert.strictEqual(rejected.statusCode, 503)
+  t.assert.strictEqual(rejected.json().code, 'FST_ERR_ROUTE_CONCURRENCY_QUEUE_FULL')
+  t.assert.deepStrictEqual(started, ['first'])
+
+  gate.resolve()
+  await Promise.all([first, second, third])
+  t.assert.deepStrictEqual(started, ['first', 'second', 'third'])
+  t.assert.deepStrictEqual(hooks, ['first', 'second', 'third'])
+})
+
+test('a queued request that outlives queueTimeout gets 503 FST_ERR_ROUTE_CONCURRENCY_QUEUE_TIMEOUT', async t => {
+  t.plan(3)
+  const fastify = Fastify()
+  const gate = deferred()
+  const started = []
+
+  fastify.get('/:id', { concurrency: { max: 1, queueLimit: 1, queueTimeout: 30 } }, async request => {
+    started.push(request.params.id)
+    if (request.params.id === 'hold') await gate.promise
+    return request.params.id
+  })
+
+  const held = fastify.inject('/hold')
+  await waitFor(() => started.length === 1)
+  const expired = await fastify.inject('/expired')
+  t.assert.strictEqual(expired.statusCode, 503)
+  t.assert.strictEqual(expired.json().code, 'FST_ERR_ROUTE_CONCURRENCY_QUEUE_TIMEOUT')
+  gate.resolve()
+  await held
+  t.assert.deepStrictEqual(started, ['hold'])
+})
+
+// --- Slot release ---
+
+test('a streaming response holds its slot until the client disconnects, then the next request runs', async t => {
+  t.plan(2)
+  const fastify = Fastify({ forceCloseConnections: true })
+  const started = []
+
+  fastify.get('/stream', { concurrency: { max: 1, queueLimit: 1, queueTimeout: 2000 } }, async (request, reply) => {
+    started.push(request.query.id)
+    if (request.query.id === 'a') {
+      const stream = new Readable({ read () {} })
+      stream.push('head')
+      return reply.send(stream)
+    }
+    return 'b-ok'
+  })
+
+  await fastify.listen({ port: 0 })
+  t.after(() => fastify.close())
+  const port = fastify.server.address().port
+
+  let client
+  const closed = new Promise(resolve => {
+    client = http.get({ port, path: '/stream?id=a' }, res => {
+      res.on('data', () => {})
+      res.on('error', () => {})
+    })
+    client.on('error', () => {})
+    client.on('close', resolve)
+  })
+  await waitFor(() => started.includes('a'))
+
+  const second = new Promise(resolve => {
+    http.get({ port, path: '/stream?id=b' }, res => {
+      let body = ''
+      res.on('data', chunk => { body += chunk })
+      res.on('end', () => resolve({ statusCode: res.statusCode, body }))
+    }).on('error', () => resolve({ statusCode: 0, body: '' }))
+  })
+  await delay(20)
+  t.assert.deepStrictEqual(started, ['a'])
+
+  client.destroy()
+  await closed
+  const result = await second
+  t.assert.deepStrictEqual([result.statusCode, result.body, started], [200, 'b-ok', ['a', 'b']])
+})
+
+test('errors thrown by the handler release the slot exactly once', async t => {
+  t.plan(3)
+  const fastify = Fastify()
+  let active = 0
+  let peak = 0
+
+  fastify.get('/boom', { concurrency: { max: 1, queueLimit: 5 } }, async () => {
+    active++
+    peak = Math.max(peak, active)
+    try {
+      throw new Error('boom')
+    } finally {
+      active--
+    }
+  })
+
+  const [a, b] = await Promise.all([fastify.inject('/boom'), fastify.inject('/boom')])
+  t.assert.strictEqual(a.statusCode, 500)
+  t.assert.strictEqual(b.statusCode, 500)
+  t.assert.strictEqual(peak, 1)
+})
