+// TestCircularExemplarStorage_Concurrent_AppendsDuringWalk appends to
+// disjoint series from several goroutines while a walk of the storage is
+// parked inside the caller's callback. The appends must not wait for the walk
+// to finish, every series must come back in ingestion order, and a later walk
+// must see every exemplar, each series oldest to newest.
+func TestCircularExemplarStorage_Concurrent_AppendsDuringWalk(t *testing.T) {
+	const (
+		appenders   = 8
+		perAppender = 2000
+		capacity    = 100000
+	)
+	exs, err := NewCircularExemplarStorage(capacity, eMetrics, 0)
+	require.NoError(t, err)
+	es := exs.(*CircularExemplarStorage)
+
+	seed := labels.FromStrings("__name__", "seed", "series", "0")
+	require.NoError(t, es.AddExemplar(seed, exemplar.Exemplar{
+		Labels: labels.FromStrings("trace_id", "seed"),
+		Value:  1,
+		Ts:     1,
+	}))
+
+	// Park a walk inside its callback for as long as the appends run.
+	walkEntered := make(chan struct{})
+	release := make(chan struct{})
+	var releaseOnce sync.Once
+	releaseWalk := func() { releaseOnce.Do(func() { close(release) }) }
+	walkDone := make(chan struct{})
+	var walkErr error
+	go func() {
+		defer close(walkDone)
+		entered := false
+		walkErr = es.IterateExemplars(func(labels.Labels, exemplar.Exemplar) error {
+			if !entered {
+				entered = true
+				close(walkEntered)
+				<-release
+			}
+			return nil
+		})
+	}()
+	<-walkEntered
+	t.Cleanup(func() {
+		releaseWalk()
+		<-walkDone
+	})
+
+	appendErrs := make(chan error, appenders)
+	var wg sync.WaitGroup
+	for a := range appenders {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			l := labels.FromStrings("__name__", "metric", "series", strconv.Itoa(a))
+			for i := range perAppender {
+				e := exemplar.Exemplar{
+					Labels: labels.FromStrings("trace_id", strconv.Itoa(a*perAppender+i)),
+					Value:  float64(i),
+					Ts:     int64(i + 2),
+				}
+				if err := es.AddExemplar(l, e); err != nil {
+					appendErrs <- err
+					return
+				}
+			}
+			appendErrs <- nil
+		}()
+	}
+	appendsDone := make(chan struct{})
+	go func() {
+		wg.Wait()
+		close(appendsDone)
+	}()
+	select {
+	case <-appendsDone:
+	case <-time.After(10 * time.Second):
+		releaseWalk()
+		t.Fatal("appends to other series waited for a walk of the storage to finish")
+	}
+	releaseWalk()
+	<-walkDone
+	require.NoError(t, walkErr)
+	close(appendErrs)
+	for err := range appendErrs {
+		require.NoError(t, err)
+	}
+
+	// Every series comes back in ingestion order: whatever was evicted, what is
+	// left is the newest run of what was appended, nothing reordered, repeated
+	// or invented.
+	nameMatcher, err := labels.NewMatcher(labels.MatchEqual, "__name__", "metric")
+	require.NoError(t, err)
+	for a := range appenders {
+		seriesMatcher, err := labels.NewMatcher(labels.MatchEqual, "series", strconv.Itoa(a))
+		require.NoError(t, err)
+		res, err := es.Select(0, math.MaxInt64, []*labels.Matcher{nameMatcher, seriesMatcher})
+		require.NoError(t, err)
+		require.Len(t, res, 1)
+		got := res[0].Exemplars
+		require.NotEmpty(t, got)
+		require.LessOrEqual(t, len(got), perAppender)
+		require.Equal(t, int64(perAppender+1), got[len(got)-1].Ts, "the newest exemplar must survive")
+		for i := 1; i < len(got); i++ {
+			require.Equal(t, got[i-1].Ts+1, got[i].Ts, "series %d is not in ingestion order", a)
+		}
+	}
+
+	// A full walk sees each series oldest to newest and never more than the
+	// configured capacity.
+	lastTs := map[string]int64{}
+	total := 0
+	require.NoError(t, es.IterateExemplars(func(l labels.Labels, e exemplar.Exemplar) error {
+		key := l.String()
+		require.Less(t, lastTs[key], e.Ts)
+		lastTs[key] = e.Ts
+		total++
+		return nil
+	}))
+	require.LessOrEqual(t, total, capacity)
+	require.GreaterOrEqual(t, len(lastTs), appenders)
+}
