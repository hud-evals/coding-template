+// numShards. Since numShards is only ever changed while every shard lock is
+// held, observing the same value after having taken a single shard lock proves
+// that the mapping we used is still the current one.
+func (ce *CircularExemplarStorage) lockShard(seriesLabels []byte, write bool) (*exemplarShard, int) {
+	h := xxhash.Sum64(seriesLabels)
+	for {
+		n := ce.numShards.Load()
+		if n == 0 {
+			return nil, 0
+		}
+		i := int(h % uint64(n))
+		s := ce.shards[i]
+		if write {
+			s.lock.Lock()
+		} else {
+			s.lock.RLock()
+		}
+		if ce.numShards.Load() == n {
+			return s, i
+		}
+		if write {
