+// TestCircularExemplarStorage_Concurrent_AddExemplar_Resize_Select exercises the
+// per series locking of the storage: many series are appended to concurrently
+// while the buffer is resized (as a config reload does), while it is queried and
+// while it is walked as a whole (as the chunk snapshot writer does).
+//
+// It asserts the two invariants that the concurrency must not break: the
+// exemplars of a series are returned in the order they were ingested, and the
+// configured size stays an upper bound of what is retained.
+func TestCircularExemplarStorage_Concurrent_AddExemplar_Resize_Select(t *testing.T) {
+	const (
+		appenders          = 8
+		seriesPerAppender  = 16
+		exemplarsPerSeries = 100
+		size               = 1000
+	)
+
+	exs, err := NewCircularExemplarStorage(size, eMetrics, 0)
+	require.NoError(t, err)
+	es := exs.(*CircularExemplarStorage)
+
+	nameMatcher := []*labels.Matcher{labels.MustNewMatcher(labels.MatchEqual, "__name__", "test")}
+
+	// Every series is appended to by exactly one goroutine with increasing
+	// timestamps, so ingestion order is timestamp order.
+	requireOrdered := func(res []exemplar.QueryResult) {
+		for _, qr := range res {
+			for i := 1; i < len(qr.Exemplars); i++ {
+				if qr.Exemplars[i].Ts <= qr.Exemplars[i-1].Ts {
+					t.Errorf("exemplars of %s are out of ingestion order: %v", qr.SeriesLabels, qr.Exemplars)
+					return
+				}
+			}
+		}
+	}
+
+	var appendWg, bgWg sync.WaitGroup
+	done := make(chan struct{})
+
+	for a := range appenders {
+		appendWg.Add(1)
+		go func() {
+			defer appendWg.Done()
+			for i := range exemplarsPerSeries {
+				for s := range seriesPerAppender {
+					l := labels.FromStrings("__name__", "test", "appender", strconv.Itoa(a), "series", strconv.Itoa(s))
+					if err := es.AddExemplar(l, exemplar.Exemplar{
+						Labels: labels.FromStrings("trace_id", strconv.Itoa(i)),
+						Value:  float64(i),
+						Ts:     int64(i + 1),
+					}); err != nil {
+						t.Errorf("unexpected error appending exemplar: %s", err)
+						return
+					}
+				}
+			}
+		}()
+	}
+
+	// Config reloads resizing the buffer under the appenders.
+	bgWg.Add(1)
+	go func() {
+		defer bgWg.Done()
+		sizes := []int64{size, size / 2, 2 * size, size / 3}
+		for i := 0; ; i++ {
+			select {
+			case <-done:
+				return
+			default:
+			}
+			es.Resize(sizes[i%len(sizes)])
+		}
+	}()
+
+	// Queries running alongside the appends.
+	bgWg.Add(1)
+	go func() {
+		defer bgWg.Done()
+		for {
+			select {
+			case <-done:
+				return
+			default:
+			}
+			res, err := es.Select(0, math.MaxInt64, nameMatcher)
+			if err != nil {
+				t.Errorf("unexpected error selecting exemplars: %s", err)
+				return
+			}
+			requireOrdered(res)
+		}
+	}()
+
+	// Something walking the whole storage, like the chunk snapshot writer.
+	bgWg.Add(1)
+	go func() {
+		defer bgWg.Done()
+		for {
+			select {
+			case <-done:
+				return
+			default:
+			}
+			if err := es.IterateExemplars(func(labels.Labels, exemplar.Exemplar) error { return nil }); err != nil {
+				t.Errorf("unexpected error iterating exemplars: %s", err)
+				return
+			}
+		}
+	}()
+
+	appendWg.Wait()
+	close(done)
+	bgWg.Wait()
+
+	res, err := es.Select(0, math.MaxInt64, nameMatcher)
+	require.NoError(t, err)
+	requireOrdered(res)
+
+	stored := 0
+	for _, qr := range res {
+		stored += len(qr.Exemplars)
+	}
+	require.NotZero(t, stored)
+	require.LessOrEqual(t, stored, len(es.exemplars), "more exemplars retained than the buffer can hold")
+}
